//@version=6
strategy("HMA Futures med Dynamisk Pyramid v6", shorttitle="HMA_Futures_v6", overlay=true, pyramiding=60, initial_capital=1000, currency=currency.USD, commission_type=strategy.commission.percent, commission_value=0.05, default_qty_type=strategy.percent_of_equity, default_qty_value=2)

// === INPUTS ===
// Grundläggande indikatorer
hmaLen = input.int(55, "HMA-längd", minval=1, group="Indikatorer")
atrLen = input.int(21, "ATR-längd", minval=1, group="Indikatorer")
rsiLen = input.int(14, "RSI-längd för pyramidfilter", group="Indikatorer")

// Trading inställningar
tradingMode = input.string("Long & Short", "Trading Mode", options=["Long Only", "Short Only", "Long & Short"], group="Trading")
tradePct = input.float(2.0, "Position per trade (%)", step=0.1, group="Trading")
pyramidLevels = input.int(60, "Max pyramidnivåer", minval=1, group="Trading")
useCompoundingWithOpenProfit = input.bool(false, "Compound med Open Profit", group="Trading", tooltip="Inkludera öppen vinst i position sizing (mer aggressivt)")

// TP och Pyramid inställningar
atrMultTP = input.float(5.5, "TP: ATR-multipel", step=0.1, group="Exit & Pyramid")
pyramidATRmult = input.float(1.0, "Pyramid-ATR-multipel", step=0.1, group="Exit & Pyramid")
trailOffsetPct = input.float(1.0, "Trail offset efter TP (%)", step=0.1, group="Exit & Pyramid")
minPyramidDropPct = input.float(0.5, "Minsta procentuell dipp för nytt pyramidköp", step=0.1, group="Exit & Pyramid")

// Filter
rsiLimitLong = input.float(50, "Max RSI för long pyramidköp", step=1, group="Filter")
rsiLimitShort = input.float(50, "Min RSI för short pyramidköp", step=1, group="Filter")
minBarsBetweenPyramids = input.int(3, "Minsta antal bars mellan pyramidköp", minval=1, group="Filter")

// Stoploss inställningar
slAtrMult = input.float(2.0, "Stop Loss (ATR x)", minval=1.0, maxval=5.0, step=0.1, group="🎯 Risk Management", tooltip="Stop loss distans i ATR från entry")

// Breakeven & Trailing
useBreakeven = input.bool(true, "Use Breakeven Move", group="🎯 Trailing & Breakeven", tooltip="Flytta SL till break-even vid profit")
breakevenActivation = input.float(1.5, "Breakeven at (R)", minval=0.5, maxval=3.0, step=0.1, group="🎯 Trailing & Breakeven", tooltip="Flytta till breakeven vid X × risk")
breakevenBuffer = input.float(0.1, "Breakeven Buffer (ATR x)", minval=0.0, maxval=0.5, step=0.05, group="🎯 Trailing & Breakeven", tooltip="Buffer över break-even")

// Cooling period
barsAfterExit = input.int(5, "Bars After Exit", minval=0, maxval=20, group="⏰ Timing", tooltip="Antal bars att vänta efter exit innan ny entry tillåts")

// Färginställningar
hmaColor = input.color(color.yellow, "HMA Linje", group="🎨 Färger")
ma200Color = input.color(color.white, "MA200 (4h)", group="🎨 Färger")
avgPriceColor = input.color(color.orange, "Average Price", group="🎨 Färger")
longPyramidColor = input.color(color.purple, "Long Pyramid", group="🎨 Färger")
longTPColor = input.color(color.green, "Long TP", group="🎨 Färger")
longSLColor = input.color(color.red, "Long SL", group="🎨 Färger")
longBEColor = input.color(color.blue, "Long Breakeven", group="🎨 Färger")
shortPyramidColor = input.color(color.maroon, "Short Pyramid", group="🎨 Färger")
shortTPColor = input.color(color.red, "Short TP", group="🎨 Färger")
shortSLColor = input.color(color.lime, "Short SL", group="🎨 Färger")
shortBEColor = input.color(color.aqua, "Short Breakeven", group="🎨 Färger")

// === BERÄKNINGAR ===
hma = ta.hma(close, hmaLen)
atr = ta.atr(atrLen)
hmaSlopeLong = hma > hma[1]
hmaSlopeShort = hma < hma[1]
bullTrend = close > hma
bearTrend = close < hma
ma200_4h = request.security(syminfo.tickerid, "240", ta.sma(close, 200), lookahead=barmerge.lookahead_off)
rsi = ta.rsi(close, rsiLen)

// === VARIABLER ===
var int longEntryCount = 0
var int shortEntryCount = 0
var int lastLongPyramidBarIndex = na
var int lastShortPyramidBarIndex = na
var float initialLongEntryPrice = 0.0
var float initialShortEntryPrice = 0.0
var float longRiskAmount = 0.0
var float shortRiskAmount = 0.0
var int lastExitBar = na

// === ENTRY CONDITIONS ===
// Cooling period check (tillåt första entry genom att sätta na som default)
barsSinceExit = na(lastExitBar) ? barsAfterExit : bar_index - lastExitBar
coolingPeriodOk = barsSinceExit >= barsAfterExit

// Long conditions
enterLong = strategy.position_size == 0 and hmaSlopeLong and bullTrend and close > ma200_4h and (tradingMode == "Long Only" or tradingMode == "Long & Short") and coolingPeriodOk

// Short conditions
enterShort = strategy.position_size == 0 and hmaSlopeShort and bearTrend and close < ma200_4h and (tradingMode == "Short Only" or tradingMode == "Long & Short") and coolingPeriodOk

// Funktion för att beräkna quantity med compounding
f_calcQty(_pct) =>
    // Använd equity + open profit om compounding med open profit är aktiverat
    baseEquity = useCompoundingWithOpenProfit ? (strategy.equity + strategy.openprofit) : strategy.equity
    baseEquity * (_pct * 0.01) / close

// === VARNINGAR FÖR FILTER ===
if close < ma200_4h and strategy.position_size == 0 and bar_index % 10 == 0 and (tradingMode == "Long Only" or tradingMode == "Long & Short")
    label.new(bar_index, high * 1.03, text="🚫 Inga long – under MA200 (4h)", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

if close > ma200_4h and strategy.position_size == 0 and bar_index % 10 == 0 and (tradingMode == "Short Only" or tradingMode == "Long & Short")
    label.new(bar_index, low * 0.97, text="🚫 Inga short – över MA200 (4h)", style=label.style_label_up, color=color.red, textcolor=color.white, size=size.normal)

// === FÖRSTA KÖP LONG ===
if enterLong
    qtyVal = f_calcQty(tradePct)
    strategy.entry("LONG", strategy.long, qty=qtyVal)
    label.new(bar_index, low * 0.97, text="Första Long\nPris: " + str.tostring(close, format.mintick) + "\nRSI: " + str.tostring(rsi, format.mintick), style=label.style_label_up, color=color.teal, textcolor=color.white)
    longEntryCount += 1
    initialLongEntryPrice := close
    longRiskAmount := atr * slAtrMult

// === FÖRSTA KÖP SHORT ===
if enterShort
    qtyVal = f_calcQty(tradePct)
    strategy.entry("SHORT", strategy.short, qty=qtyVal)
    label.new(bar_index, high * 1.03, text="Första Short\nPris: " + str.tostring(close, format.mintick) + "\nRSI: " + str.tostring(rsi, format.mintick), style=label.style_label_down, color=color.orange, textcolor=color.white)
    shortEntryCount += 1
    initialShortEntryPrice := close
    shortRiskAmount := atr * slAtrMult

// === PYRAMIDKÖP LONG ===
longPyramidThreshold = strategy.position_avg_price - atr * pyramidATRmult
longMinDrop = strategy.position_avg_price * (1 - minPyramidDropPct / 100)
longRsiFilter = rsi < rsiLimitLong
barsSinceLastLongPyramid = bar_index - nz(lastLongPyramidBarIndex, 0)
isLongDipp = strategy.position_size > 0 and close <= longPyramidThreshold and close < close[1] and close <= longMinDrop and longEntryCount < pyramidLevels and close > ma200_4h and longRsiFilter and barsSinceLastLongPyramid >= minBarsBetweenPyramids

if isLongDipp
    qtyVal = f_calcQty(tradePct)
    strategy.entry("LONG", strategy.long, qty=qtyVal)
    label.new(bar_index, low * 0.97, text="Long Pyramid " + str.tostring(longEntryCount + 1) + "\nPris: " + str.tostring(close, format.mintick) + "\nRSI: " + str.tostring(rsi, format.mintick), style=label.style_label_up, color=color.green, textcolor=color.white)
    longEntryCount += 1
    lastLongPyramidBarIndex := bar_index

// === PYRAMIDKÖP SHORT ===
shortPyramidThreshold = strategy.position_avg_price + atr * pyramidATRmult
shortMinRise = strategy.position_avg_price * (1 + minPyramidDropPct / 100)
shortRsiFilter = rsi > rsiLimitShort
barsSinceLastShortPyramid = bar_index - nz(lastShortPyramidBarIndex, 0)
isShortRise = strategy.position_size < 0 and close >= shortPyramidThreshold and close > close[1] and close >= shortMinRise and shortEntryCount < pyramidLevels and close < ma200_4h and shortRsiFilter and barsSinceLastShortPyramid >= minBarsBetweenPyramids

if isShortRise
    qtyVal = f_calcQty(tradePct)
    strategy.entry("SHORT", strategy.short, qty=qtyVal)
    label.new(bar_index, high * 1.03, text="Short Pyramid " + str.tostring(shortEntryCount + 1) + "\nPris: " + str.tostring(close, format.mintick) + "\nRSI: " + str.tostring(rsi, format.mintick), style=label.style_label_down, color=color.red, textcolor=color.white)
    shortEntryCount += 1
    lastShortPyramidBarIndex := bar_index

// === EXIT MANAGEMENT ===
// LONG Position Management
if strategy.position_size > 0
    // Beräkna profit i R (med skydd mot division by zero)
    longProfitInR = longRiskAmount > 0 ? (close - initialLongEntryPrice) / longRiskAmount : 0

    // Beräkna SL-nivå baserat på current state
    longStopPrice = initialLongEntryPrice - (atr * slAtrMult)  // Default initial SL

    // Om breakeven är aktiverad och profiten är tillräcklig, flytta SL till breakeven
    if useBreakeven and longProfitInR >= breakevenActivation
        longStopPrice := initialLongEntryPrice + (atr * breakevenBuffer)

    // Om trailing är aktiverat (pris över TP), använd trailing istället
    longTpPrice = strategy.position_avg_price + atr * atrMultTP
    if close >= longTpPrice
        longTrailOffset = longTpPrice * (trailOffsetPct / 100)
        strategy.exit("LONG_EXIT", from_entry="LONG", trail_price=close, trail_offset=longTrailOffset)
    else
        // Använd stop loss (antingen initial eller breakeven)
        strategy.exit("LONG_EXIT", from_entry="LONG", stop=longStopPrice)

// SHORT Position Management
if strategy.position_size < 0
    // Beräkna profit i R (med skydd mot division by zero)
    shortProfitInR = shortRiskAmount > 0 ? (initialShortEntryPrice - close) / shortRiskAmount : 0

    // Beräkna SL-nivå baserat på current state
    shortStopPrice = initialShortEntryPrice + (atr * slAtrMult)  // Default initial SL

    // Om breakeven är aktiverad och profiten är tillräcklig, flytta SL till breakeven
    if useBreakeven and shortProfitInR >= breakevenActivation
        shortStopPrice := initialShortEntryPrice - (atr * breakevenBuffer)

    // Om trailing är aktiverat (pris under TP), använd trailing istället
    shortTpPrice = strategy.position_avg_price - atr * atrMultTP
    if close <= shortTpPrice
        shortTrailOffset = shortTpPrice * (trailOffsetPct / 100)
        strategy.exit("SHORT_EXIT", from_entry="SHORT", trail_price=close, trail_offset=shortTrailOffset)
    else
        // Använd stop loss (antingen initial eller breakeven)
        strategy.exit("SHORT_EXIT", from_entry="SHORT", stop=shortStopPrice)

// === RESET COUNTERS ===
wasInPosition = strategy.position_size[1] != 0
nowNoPosition = strategy.position_size == 0

if wasInPosition and nowNoPosition
    lastExitBar := bar_index
    longEntryCount := 0
    shortEntryCount := 0
    lastLongPyramidBarIndex := na
    lastShortPyramidBarIndex := na
    initialLongEntryPrice := 0.0
    initialShortEntryPrice := 0.0
    longRiskAmount := 0.0
    shortRiskAmount := 0.0

// === PLOTTNING ===
plot(hma, title="HMA", color=hmaColor, linewidth=2)
plot(strategy.position_size != 0 ? strategy.position_avg_price : na, title="Inköpspris", color=avgPriceColor, linewidth=2)
plot(ma200_4h, title="MA200 (4h)", color=ma200Color, linewidth=1, style=plot.style_line)

// Long plots (deklarera variabler före plotting)
var float longSLPlot = na
var float longTPPlot = na
var float longBEPlot = na

if strategy.position_size > 0
    longSLPlot := initialLongEntryPrice - (atr * slAtrMult)
    longTPPlot := strategy.position_avg_price + atr * atrMultTP
    // Endast visa breakeven om den är aktiverad OCH profiten är tillräcklig
    safelongProfitInR = longRiskAmount > 0 ? (close - initialLongEntryPrice) / longRiskAmount : 0
    longBEPlot := (useBreakeven and safelongProfitInR >= breakevenActivation) ? initialLongEntryPrice + (atr * breakevenBuffer) : na
else
    longSLPlot := na
    longTPPlot := na
    longBEPlot := na

plot(strategy.position_size > 0 ? longPyramidThreshold : na, title="Long Pyramidnivå", color=longPyramidColor, style=plot.style_stepline)
plot(longTPPlot, title="Long TP", color=longTPColor, style=plot.style_stepline, linewidth=2)
plot(longSLPlot, title="Long SL", color=longSLColor, style=plot.style_stepline, linewidth=2)
plot(longBEPlot, title="Long Breakeven", color=longBEColor, style=plot.style_cross, linewidth=2)

// Short plots (deklarera variabler före plotting)
var float shortSLPlot = na
var float shortTPPlot = na
var float shortBEPlot = na

if strategy.position_size < 0
    shortSLPlot := initialShortEntryPrice + (atr * slAtrMult)
    shortTPPlot := strategy.position_avg_price - atr * atrMultTP
    // Endast visa breakeven om den är aktiverad OCH profiten är tillräcklig
    safeshortProfitInR = shortRiskAmount > 0 ? (initialShortEntryPrice - close) / shortRiskAmount : 0
    shortBEPlot := (useBreakeven and safeshortProfitInR >= breakevenActivation) ? initialShortEntryPrice - (atr * breakevenBuffer) : na
else
    shortSLPlot := na
    shortTPPlot := na
    shortBEPlot := na

plot(strategy.position_size < 0 ? shortPyramidThreshold : na, title="Short Pyramidnivå", color=shortPyramidColor, style=plot.style_stepline)
plot(shortTPPlot, title="Short TP", color=shortTPColor, style=plot.style_stepline, linewidth=2)
plot(shortSLPlot, title="Short SL", color=shortSLColor, style=plot.style_stepline, linewidth=2)
plot(shortBEPlot, title="Short Breakeven", color=shortBEColor, style=plot.style_cross, linewidth=2)

// Background colors
bgcolor(enterLong ? color.new(color.green, 85) : enterShort ? color.new(color.red, 85) : na, title="Entry Status")

// === DASHBOARD ===
var table dashboard = table.new(position.top_right, 2, 14, border_width=2, border_color=color.gray, frame_color=color.gray, frame_width=1)

if barstate.islast
    // Header
    table.cell(dashboard, 0, 0, "📊 HMA Futures Pyramid v6", text_color=color.white, bgcolor=color.new(color.blue, 30), text_size=size.normal)
    table.merge_cells(dashboard, 0, 0, 1, 0)

    // HMA Trend
    hmaColor = hmaSlopeLong ? color.green : hmaSlopeShort ? color.red : color.gray
    hmaText = hmaSlopeLong ? "BULL" : hmaSlopeShort ? "BEAR" : "FLAT"
    table.cell(dashboard, 0, 1, "HMA", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 1, hmaText, text_color=color.white, bgcolor=color.new(hmaColor, 70), text_size=size.small)

    // RSI
    rsiColor = rsi > 60 ? color.green : rsi < 40 ? color.red : color.gray
    table.cell(dashboard, 0, 2, "RSI", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 2, str.tostring(rsi, "#.#"), text_color=color.white, bgcolor=color.new(rsiColor, 70), text_size=size.small)

    // ATR
    table.cell(dashboard, 0, 3, "ATR", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 3, str.tostring(atr, "#.####"), text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)

    // MA200 Filter
    ma200Color = close > ma200_4h ? color.green : color.red
    ma200Text = close > ma200_4h ? "ABOVE" : "BELOW"
    table.cell(dashboard, 0, 4, "MA200 (4h)", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 4, ma200Text, text_color=color.white, bgcolor=color.new(ma200Color, 70), text_size=size.small)

    // Position
    posSize = strategy.position_size
    posText = posSize > 0 ? "LONG" : posSize < 0 ? "SHORT" : "NONE"
    posColor = posSize > 0 ? color.green : posSize < 0 ? color.red : color.gray
    table.cell(dashboard, 0, 5, "Position", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 5, posText, text_color=color.white, bgcolor=color.new(posColor, 70), text_size=size.small)

    // Entry Count
    entryCountText = posSize > 0 ? str.tostring(longEntryCount) : posSize < 0 ? str.tostring(shortEntryCount) : "0"
    table.cell(dashboard, 0, 6, "Entries", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 6, entryCountText + "/" + str.tostring(pyramidLevels), text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)

    // Profit in R
    profitR = posSize > 0 and longRiskAmount > 0 ? (close - initialLongEntryPrice) / longRiskAmount : posSize < 0 and shortRiskAmount > 0 ? (initialShortEntryPrice - close) / shortRiskAmount : 0
    profitRColor = profitR > 0 ? color.green : profitR < 0 ? color.red : color.gray
    table.cell(dashboard, 0, 7, "Profit (R)", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 7, str.tostring(profitR, "#.##") + "R", text_color=color.white, bgcolor=color.new(profitRColor, 70), text_size=size.small)

    // P&L %
    pnlPct = strategy.openprofit / strategy.equity * 100
    pnlColor = pnlPct > 0 ? color.green : pnlPct < 0 ? color.red : color.gray
    table.cell(dashboard, 0, 8, "Open P&L %", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 8, str.tostring(pnlPct, "#.##") + "%", text_color=color.white, bgcolor=color.new(pnlColor, 70), text_size=size.small)

    // Breakeven Status
    beActive = useBreakeven and ((posSize > 0 and profitR >= breakevenActivation) or (posSize < 0 and profitR >= breakevenActivation))
    beText = useBreakeven ? (beActive ? "ACTIVE" : "WAIT") : "OFF"
    beColor = beActive ? color.green : useBreakeven ? color.orange : color.gray
    table.cell(dashboard, 0, 9, "Breakeven", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 9, beText, text_color=color.white, bgcolor=color.new(beColor, 70), text_size=size.small)

    // Cooling Period
    barsLeft = math.max(0, barsAfterExit - barsSinceExit)
    coolingText = barsAfterExit == 0 ? "OFF" : (coolingPeriodOk ? "OK ✓" : str.tostring(barsLeft) + "/" + str.tostring(barsAfterExit))
    coolingColor = barsAfterExit == 0 ? color.gray : (coolingPeriodOk ? color.green : color.orange)
    table.cell(dashboard, 0, 10, "Cooling", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 10, coolingText, text_color=color.white, bgcolor=color.new(coolingColor, 70), text_size=size.small)

    // Win Rate
    winRate = strategy.wintrades / math.max(strategy.closedtrades, 1) * 100
    wrColor = winRate >= 50 ? color.green : color.red
    table.cell(dashboard, 0, 11, "Win Rate", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 11, str.tostring(winRate, "#.#") + "%", text_color=color.white, bgcolor=color.new(wrColor, 70), text_size=size.small)

    // Total Trades
    table.cell(dashboard, 0, 12, "Trades", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 12, str.tostring(strategy.closedtrades), text_color=color.white, bgcolor=color.new(color.blue, 70), text_size=size.small)

    // Net Profit %
    netProfitPct = (strategy.netprofit / strategy.initial_capital) * 100
    npColor = netProfitPct > 0 ? color.green : color.red
    table.cell(dashboard, 0, 13, "Net Profit %", text_color=color.white, bgcolor=color.new(color.gray, 70), text_size=size.small)
    table.cell(dashboard, 1, 13, str.tostring(netProfitPct, "#.##") + "%", text_color=color.white, bgcolor=color.new(npColor, 70), text_size=size.small)
