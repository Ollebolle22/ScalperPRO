// 🛡️ DYNAMISK STOP LOSS (Volatilitetsbaserad)
useDynamicSL = input.bool(true, "✓ Dynamisk Stop Loss", group=grpRisk, tooltip="SL anpassas efter marknadsvolatilitet")
