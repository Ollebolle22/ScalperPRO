slMaxMultiplier = input.float(4.0, "🛑 SL Max Multipel (hög vol)", step=0.1, group=grpRisk, tooltip="Maximum SL vid hög volatilitet - bredare SL")
atrMultSL = input.float(3.0, "⚠️ Fallback SL Multipel", step=0.1, group=grpRisk, tooltip="Används endast om dynamisk SL är avstängd")

// ⏰ SL COOLDOWN EFTER SISTA DCA
sl_cooldown_after_dca = input.int(15, "⏰ SL Cooldown efter sista DCA (bars)", minval=0, group=grpRisk, tooltip="Vänta X bars efter sista DCA innan SL aktiveras - ger DCA chans att jobba")

// 🎯 VOLATILITET (delad för alla dynamiska beräkningar)
volThreshold = input.float(1.3, "📈 Volatilitetströskel", step=0.1, group=grpRisk, tooltip="ATR/SMA(ATR) över detta = hög volatilitet")
volAvgLength = input.int(50, "📊 Volatilitets Genomsnitt", step=5, group=grpRisk, tooltip="Period för att jämföra aktuell ATR")

// Partial Profit System (MULTI-LEVEL!)
usePartialTP = input.bool(true, "✓ Partial Take Profit System", group=grpRisk, tooltip="Multi-level partial TP - ta vinst stegvis")
numPartialLevels = input.int(3, "Antal Partial TP Nivåer", step=1, group=grpRisk, tooltip="1-4 partial TP nivåer (0 = av)")

// 📊 DYNAMISKA PARTIAL TP (ATR-baserade och uppdateras löpande)
useDynamicPartialTP = input.bool(true, "✓ Dynamiska TP baserat på löpande ATR", group=grpRisk, tooltip="TP-nivåer uppdateras kontinuerligt baserat på aktuell ATR")
tp_atr_adjustment_freq = input.int(5, "TP ATR Update Frekvens (bars)", minval=1, group=grpRisk, tooltip="Hur ofta TP-nivåer uppdateras baserat på ATR")

// 🎯 TP TRAILING
use_tp_trailing = input.bool(true, "✓ TP Trailing", group=grpRisk, tooltip="Trail TP-nivåer när priset närmar sig")
tp_trail_activation_pct = input.float(90.0, "TP Trail Aktivering %", step=5.0, group=grpRisk, tooltip="Trail när priset når X% av avståndet till TP")
tp_trail_offset_pct = input.float(0.3, "TP Trail Offset %", step=0.1, group=grpRisk, tooltip="Trail TP denna % från högsta/lägsta pris")

// ⏰ TP TIME DECAY
use_tp_time_decay = input.bool(true, "✓ TP Time Decay", group=grpRisk, tooltip="Dra ner TP3/TP4 närmare med tiden om de inte träffas")
tp_decay_start_bars = input.int(20, "Decay Start (bars)", minval=1, group=grpRisk, tooltip="Börja dra ner TP3/TP4 efter X bars")
tp_decay_rate = input.float(0.5, "Decay Rate %", step=0.1, group=grpRisk, tooltip="Hur mycket % TP3/TP4 dras ner per 10 bars")

// Partial TP Level 1
partial1_enabled = numPartialLevels >= 1
partial1_pct = input.float(25.0, "📊 TP1: % av position", step=5.0, group=grpRisk, tooltip="Procent att sälja vid första TP")
partial1_base_R = input.float(1.2, "📊 TP1: Base R (låg vol)", step=0.25, group=grpRisk, tooltip="TP1 R-multipel vid låg volatilitet")
partial1_max_R = input.float(2.0, "📊 TP1: Max R (hög vol)", step=0.25, group=grpRisk, tooltip="TP1 R-multipel vid hög volatilitet")
partial1_trigger = input.float(1.5, "⚠️ TP1: Fallback R", step=0.25, group=grpRisk, tooltip="Används om dynamisk TP är av")

// Partial TP Level 2
partial2_enabled = numPartialLevels >= 2
partial2_pct = input.float(25.0, "📊 TP2: % av position", step=5.0, group=grpRisk, tooltip="Procent att sälja vid andra TP")
partial2_base_R = input.float(2.0, "📊 TP2: Base R (låg vol)", step=0.25, group=grpRisk, tooltip="TP2 R-multipel vid låg volatilitet")
partial2_max_R = input.float(3.5, "📊 TP2: Max R (hög vol)", step=0.25, group=grpRisk, tooltip="TP2 R-multipel vid hög volatilitet")
partial2_trigger = input.float(2.5, "⚠️ TP2: Fallback R", step=0.25, group=grpRisk, tooltip="Används om dynamisk TP är av")

// Partial TP Level 3
partial3_enabled = numPartialLevels >= 3
partial3_pct = input.float(25.0, "📊 TP3: % av position", step=5.0, group=grpRisk, tooltip="Procent att sälja vid tredje TP")
partial3_base_R = input.float(2.8, "📊 TP3: Base R (låg vol)", step=0.25, group=grpRisk, tooltip="TP3 R-multipel vid låg volatilitet")
partial3_max_R = input.float(5.0, "📊 TP3: Max R (hög vol)", step=0.25, group=grpRisk, tooltip="TP3 R-multipel vid hög volatilitet")
partial3_trigger = input.float(3.5, "⚠️ TP3: Fallback R", step=0.25, group=grpRisk, tooltip="Används om dynamisk TP är av")

// Partial TP Level 4
partial4_enabled = numPartialLevels >= 4
partial4_pct = input.float(25.0, "📊 TP4: % av position", step=5.0, group=grpRisk, tooltip="Procent att sälja vid fjärde TP")
partial4_base_R = input.float(4.0, "📊 TP4: Base R (låg vol)", step=0.25, group=grpRisk, tooltip="TP4 R-multipel vid låg volatilitet")
partial4_max_R = input.float(7.0, "📊 TP4: Max R (hög vol)", step=0.25, group=grpRisk, tooltip="TP4 R-multipel vid hög volatilitet")
partial4_trigger = input.float(5.0, "⚠️ TP4: Fallback R", step=0.25, group=grpRisk, tooltip="Används om dynamisk TP är av")

// Trailing Stop (FIXAD!)
useTrailingStop = input.bool(true, "✓ Use Trailing Stop", group=grpRisk, tooltip="FIXAD implementation")
trailActivation = input.float(2.0, "Trail Activation (R)", step=0.25, group=grpRisk, tooltip="NYT: Aktivera trailing vid 2R vinst")
trailOffset = input.float(1.2, "Trailing Stop ATR Mult", step=0.1, group=grpRisk, tooltip="Minskat från 1.5 - tightare trailing")

// Breakeven
useBreakeven = input.bool(true, "✓ Flytta SL till breakeven", group=grpRisk, tooltip="Rekommenderat för 15min")
breakevenTrigger = input.float(1.2, "Breakeven vid R-multipel", step=0.1, group=grpRisk, tooltip="Ökat från 1.0 till 1.2")

// ═══════════════════════════════════════════════════════════════════════════════════════════════════
// 📖 SÅ FUNGERAR STOP LOSS I DENNA STRATEGI - LÄS DETTA!
// ═══════════════════════════════════════════════════════════════════════════════════════════════════
//
// VIKTIG INFORMATION OM STOP LOSS BETEENDE:
//
// 1️⃣ INITIAL SL PLACERING (vid entry):
//    - SL beräknas från entry-pris minus ATR × atrMultSL (default 3.0 ATR)
//    - OM DCA är aktiverat: SL justeras för att ligga BORTOM sista DCA-nivån
//      Exempel: Med 2 DCA @ 2.5 ATR spacing → SL = 5.5 ATR (2×2.5 + 0.5 buffer)
//    - SL filtreras genom liquidation-skydd (säkerställer minsta avstånd till liq)
//
// 2️⃣ SL AKTIVERING - KRITISKT ATT FÖRSTÅ:
//    ❌ SL är INAKTIV medan DCA entries pågår (dca_count < dca_max_entries)
//    ✅ SL aktiveras ENDAST när ALLA DCA entries är klara (dca_count >= dca_max_entries)
//    ⚠️  UNDANTAG: Liquidation emergency stop triggar ALLTID (oavsett DCA status)
//
//    Detta betyder:
//    - Under DCA-fas: Kan bara exit via TP eller Partial TP
//    - Efter DCA-fas: Normal risk management (SL, TP, Trailing, Breakeven)
//
// 3️⃣ SL UPPDATERINGAR (efter varje DCA):
//    - När DCA körs → Ny avg_entry beräknas
//    - SL omberäknas från nya avg_entry (inte från original entry)
//    - TP omberäknas också från nya avg_entry
//    - Detta ger dynamisk risk management baserat på faktiskt genomsnittspris
//
// 4️⃣ BREAKEVEN MOVE (när vinst >= breakevenTrigger):
//    - SL flyttas till avg_entry + lite marginal (0.1 ATR)
//    - Skyddar mot att gå back i förlust efter vinst
//    - Triggar vid 1.2R profit (konfigurerbart)
//
// 5️⃣ TRAILING STOP (när vinst >= trailActivation):
//    - Aktiveras vid 2.0R profit
//    - SL följer priset på avstånd = trailOffset × ATR (default 1.2 ATR)
//    - Uppdateras kontinuerligt när nya highs/lows bildas
//    - Låser in vinst samtidigt som positionen får köra
//
// 6️⃣ LIQUIDATION EMERGENCY:
//    - Övervakar konstant avstånd till liquidation price
//    - Om avstånd < min_liq_distance (8%) → TVÅNGSCLOSE
//    - Detta går FÖRE alla andra SL-regler
//    - Skyddar mot total förlust vid extrema rörelser
//
// SAMMANFATTNING:
// Entry → DCA fas (endast TP möjlig) → Alla DCAs klara → SL aktiveras →
// → Breakeven vid 1.2R → Trailing vid 2.0R → Exit via SL/TP
//
// ═══════════════════════════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
// 📦 VOLUME FILTER (STRIKTARE)
// ══════════════════════════════════════════════════════════════════════════════

grpVol = "📦 Volume Filter [Tightened]"
useVolFilter = input.bool(true, "✓ Use Volume Filter", group=grpVol, tooltip="KRITISKT - filtrera låg volym")
volMultiplier = input.float(1.4, "Volume Multiplier", step=0.1, group=grpVol, tooltip="1.4x = volym måste vara 40% över genomsnitt")
volLen = input.int(24, "Volume MA Length", group=grpVol, tooltip="24 bars = 6 timmar på 15min")
volIncreasing = input.bool(false, "✓ Kräv ökande volym", group=grpVol, tooltip="Extra strikt filter - kan aktiveras för ännu färre trades")

// ══════════════════════════════════════════════════════════════════════════════
// ⏰ SESSION FILTER (FÖRBÄTTRAD)
// ══════════════════════════════════════════════════════════════════════════════

grpSession = "⏰ Session Filter"
useSessionFilter = input.bool(true, "✓ Use Session Filter", group=grpSession, tooltip="REKOMMENDERAT för 15min - handla rätt timmar")
sessionStart = input.session("0800-2200", "Trading Session", group=grpSession, tooltip="08-22 CET rekommenderas (undvik natt)")
avoidFirstBar = input.bool(true, "✓ Undvik första bar i session", group=grpSession, tooltip="NYT: Undvik entry första 15min")

// ══════════════════════════════════════════════════════════════════════════════
// 🤖 BOT CONFIG
// ══════════════════════════════════════════════════════════════════════════════

grpBot = "🤖 Bot Config"
bot_id = input.string("b5b6069f87e87df334c11c36", "🤖 Bot ID", group=grpBot)
exchange_name = input.string("HyperLiquid", "Exchange", options=["HyperLiquid", "Binance", "Bybit", "OKX"], group=grpBot)
pair_name = input.string("HYPE-USDC", "Trading Pair", group=grpBot)
strategy_name_bot = input.string("HYPE_15M", "Strategy Name", group=grpBot)

// ══════════════════════════════════════════════════════════════════════════════
// 🖥️ DISPLAY SETTINGS
// ══════════════════════════════════════════════════════════════════════════════

grpDisplay = "🖥️ Display Settings"
showInfoPanel = input.bool(true, "📋 Show Info Panel", group=grpDisplay)
showTradeLabels = input.bool(true, "🏷️ Show Trade Labels", group=grpDisplay)
showEMAs = input.bool(true, "📈 Show EMAs", group=grpDisplay)
showBollingerBands = input.bool(true, "📊 Show Bollinger Bands", group=grpDisplay, tooltip="Visa Bollinger Bands för HIGHBB DCA")
showSLTP = input.bool(true, "🎯 Show SL/TP Lines", group=grpDisplay)
showLiqLine = input.bool(true, "⚠️ Show Liquidation Line", group=grpDisplay)
showDCALevels = input.bool(true, "🔄 Show DCA Levels", group=grpDisplay)
showPartialTP = input.bool(true, "📊 Show Partial TP Line", group=grpDisplay)
showBreakeven = input.bool(true, "🎯 Show Breakeven Line", group=grpDisplay)

// ══════════════════════════════════════════════════════════════════════════════
// 🎨 COLORS
// ══════════════════════════════════════════════════════════════════════════════

grpColors = "🎨 Colors"
colFastEMA = input.color(#2962FF, "Fast EMA", group=grpColors)
colSlowEMA = input.color(#FF6D00, "Slow EMA", group=grpColors)
colTrendEMA = input.color(#9C27B0, "Trend EMA", group=grpColors)
colBull = input.color(#26A69A, "Bullish", group=grpColors)
colBear = input.color(#EF5350, "Bearish", group=grpColors)
colSL = input.color(#F23645, "🛑 Stop Loss", group=grpColors)
colPartial = input.color(#FFA726, "📊 Partial TP (1-4)", group=grpColors)
colLiq = input.color(#E040FB, "⚠️ Liquidation", group=grpColors)
colDCA = input.color(#FF9800, "🔄 DCA Levels", group=grpColors)
colUnitCost = input.color(#FFEB3B, "🏷️ Unit Cost (Avg Entry)", group=grpColors)
colBreakeven = input.color(#2196F3, "⚖️ Breakeven", group=grpColors)
colBBUpper = input.color(#9C27B0, "📊 BB Upper", group=grpColors)
colBBLower = input.color(#9C27B0, "📊 BB Lower", group=grpColors)
colBBBasis = input.color(#757575, "📊 BB Basis", group=grpColors)

// ══════════════════════════════════════════════════════════════════════════════
// 📐 INDICATORS
// ══════════════════════════════════════════════════════════════════════════════

// EMAs
emaFast = ta.ema(emaSource, emaFastLen)
emaSlow = ta.ema(emaSource, emaSlowLen)
emaTrend = ta.ema(emaSource, emaTrendLen)

// MACD
[macdLine, signalLine, histLine] = ta.macd(macdSource, macdFast, macdSlow, macdSignal)

// ATR
atrValue = ta.atr(atrLen)

// 📊 BOLLINGER BANDS (för HIGHBB DCA)
bb_basis = ta.sma(close, bb_length)
bb_dev = ta.stdev(close, bb_length)
bb_upper = bb_basis + bb_mult * bb_dev
bb_lower = bb_basis - bb_mult * bb_dev

// 📉 RSI (för RSI DCA)
rsi = ta.rsi(close, rsi_length)

// 🎯 VOLATILITETSBERÄKNING (för alla dynamiska system)
atrAvg = ta.sma(atrValue, volAvgLength)
volRatio = atrValue / atrAvg  // Hur volatil är marknaden just nu?

// ═══════════════════════════════════════════════════════════════════════════════
// 🔧 HELPER FUNCTIONS (v13.0 improvement)
// ═══════════════════════════════════════════════════════════════════════════════

// Interpolate between two values based on volatility ratio
interpolate(lowVal, highVal, ratio, threshold) =>
    if ratio >= threshold
        highVal
    else if ratio <= 1.0
        lowVal
    else
        progress = (ratio - 1.0) / (threshold - 1.0)
        lowVal + (progress * (highVal - lowVal))

// ═══════════════════════════════════════════════════════════════════════════════
// 📊 DYNAMISKA MULTIPLAR (using helper function)
// ═══════════════════════════════════════════════════════════════════════════════

// Dynamic SL Multiplier (cleaner with helper function)
dynamicSLMult = useDynamicSL ? interpolate(slBaseMultiplier, slMaxMultiplier, volRatio, volThreshold) : atrMultSL

// Dynamic DCA Spacing Multiplier
dynamicDCAMult = useDynamicDCA ? interpolate(dcaBaseMultiplier, dcaMaxMultiplier, volRatio, volThreshold) : dca_atr_mult

// Dynamic Partial TP R-Multipliers
dynamicPartial1_R = useDynamicPartialTP ? interpolate(partial1_base_R, partial1_max_R, volRatio, volThreshold) : partial1_trigger
dynamicPartial2_R = useDynamicPartialTP ? interpolate(partial2_base_R, partial2_max_R, volRatio, volThreshold) : partial2_trigger
dynamicPartial3_R = useDynamicPartialTP ? interpolate(partial3_base_R, partial3_max_R, volRatio, volThreshold) : partial3_trigger
dynamicPartial4_R = useDynamicPartialTP ? interpolate(partial4_base_R, partial4_max_R, volRatio, volThreshold) : partial4_trigger

// Volume
volMA = ta.sma(volume, volLen)

// ADX (NYT!)
[diPlus, diMinus, adxValue] = ta.dmi(adxLen, adxLen)

// ══════════════════════════════════════════════════════════════════════════════
// 🛡️ FILTERS
// ══════════════════════════════════════════════════════════════════════════════

// Volume Filter (FÖRBÄTTRAD)
volCondition = not useVolFilter or (volume > volMA * volMultiplier and (not volIncreasing or volume > volume[1]))

// Session Filter (FÖRBÄTTRAD)
inSession = not useSessionFilter or not na(time(timeframe.period, sessionStart))
var int barsInSession = 0
if inSession and not inSession[1]
    barsInSession := 0
if inSession
    barsInSession += 1
notFirstBar = not avoidFirstBar or barsInSession > 1

// ADX Filter (NYT!)
adxCondition = not useADX or adxValue >= adxThreshold
strongTrend = adxValue >= adxStrong

// EMA Spacing (NYT!)
emaSpacingLong = math.abs(emaFast - emaSlow) / close * 100 >= emaSpacing
emaSpacingShort = math.abs(emaFast - emaSlow) / close * 100 >= emaSpacing

// ══════════════════════════════════════════════════════════════════════════════
// 🛡️ LIKVIDATIONSSKYDD
// ══════════════════════════════════════════════════════════════════════════════

calc_liq_price(entry, is_long) =>
    liq_pct = (1.0 / leverage) - 0.005
    is_long ? entry * (1 - liq_pct) : entry * (1 + liq_pct)

calc_safe_sl(entry, raw_sl, is_long) =>
    liq = calc_liq_price(entry, is_long)
    if is_long
        dist_to_liq = entry - liq
        max_sl_dist = dist_to_liq * (100 - liq_buffer_pct) / 100
        min_sl = entry - max_sl_dist
        math.max(raw_sl, min_sl)
    else
        dist_to_liq = liq - entry
        max_sl_dist = dist_to_liq * (100 - liq_buffer_pct) / 100
        max_sl = entry + max_sl_dist
        math.min(raw_sl, max_sl)

is_near_liquidation(entry, current, is_long) =>
    liq = calc_liq_price(entry, is_long)
    dist = is_long ? (current - liq) / current * 100 : (liq - current) / current * 100
    dist < min_liq_distance

// ══════════════════════════════════════════════════════════════════════════════
// 🎯 ENTRY SIGNALS (STRIKTARE!)
// ══════════════════════════════════════════════════════════════════════════════

// Trend Conditions
bullTrend = emaFast > emaSlow and (not requireTrendAlignment or close > emaTrend)
bearTrend = emaFast < emaSlow and (not requireTrendAlignment or close < emaTrend)

// EMA Crosses
emaBullCross = ta.crossover(emaFast, emaSlow)
emaBearCross = ta.crossunder(emaFast, emaSlow)

// MACD Conditions (FÖRBÄTTRADE)
macdCrossUp = ta.crossover(macdLine, signalLine)
macdCrossDown = ta.crossunder(macdLine, signalLine)
macdHistGrowing = histLine > histLine[1]
macdHistFalling = histLine < histLine[1]

macdLongOK = not useMACD or (macdCrossUp and (not macdHistIncreasing or macdHistGrowing))
macdShortOK = not useMACD or (macdCrossDown and (not macdHistIncreasing or macdHistFalling))

// Trend Alignment
trendAlignLong = not requireTrendAlignment or close > emaTrend
trendAlignShort = not requireTrendAlignment or close < emaTrend

// MAIN ENTRY CONDITIONS (BALANSERAD)
// Entry när: (EMA Cross ELLER Stark Trend) + alla confirming filters
strongBullMomentum = bullTrend and macdLongOK and close > close[1] and high > high[1]
strongBearMomentum = bearTrend and macdShortOK and close < close[1] and low < low[1]

// v13.0: ADX filter on EMA crosses (optional)
emaCrossADXOK = not filterEMACrossWithADX or adxCondition

longSignal = (emaBullCross and emaCrossADXOK) or (strongBullMomentum and adxCondition)
shortSignal = (emaBearCross and emaCrossADXOK) or (strongBearMomentum and adxCondition)

longCond = longSignal and trendAlignLong and volCondition and inSession and notFirstBar and emaSpacingLong
shortCond = shortSignal and trendAlignShort and volCondition and inSession and notFirstBar and emaSpacingShort

// ══════════════════════════════════════════════════════════════════════════════
// 💾 STATE VARIABLES
// ══════════════════════════════════════════════════════════════════════════════

var float entry_price = na
var float avg_entry = na  // För interna SL/TP beräkningar
var float stop_loss = na
var float partial_tp1_price = na
var float partial_tp2_price = na
var float partial_tp3_price = na
var float partial_tp4_price = na
var float liq_price = na
var float initial_sl_dist = na
var int dca_count = 0
var float base_qty = 0.0
var float total_qty = 0.0
var bool is_long = false
var bool is_short = false
var bool partial1_taken = false
var bool partial2_taken = false
var bool partial3_taken = false
var bool partial4_taken = false
var bool breakeven_moved = false
var bool trail_activated = false
var float trail_high = na
var float trail_low = na

// 🎯 TP Trailing State
var bool tp1_trailing = false
var bool tp2_trailing = false
var bool tp3_trailing = false
var bool tp4_trailing = false
var float tp1_trail_high = na
var float tp2_trail_high = na
var float tp3_trail_high = na
var float tp4_trail_high = na
var float tp1_trail_low = na
var float tp2_trail_low = na
var float tp3_trail_low = na
var float tp4_trail_low = na

// 📊 Dynamisk TP Update Counter
var int tp_update_counter = 0

// ⏰ TP Time Decay Tracking
var int bars_since_partial2 = 0

// ⏰ DCA Cooldown Tracking
var int bars_since_last_dca = 999

// ⏰ SL Cooldown efter sista DCA
var int bars_since_all_dcas_complete = 0
var bool all_dcas_completed = false

in_position = strategy.position_size != 0

// 🔔 Exit Alert Deduplication Flag (WunderTrading)
var bool exit_alert_sent_this_bar = false
exit_alert_sent_this_bar := false  // Reset varje bar

// Reset på flat
if not in_position and (is_long[1] or is_short[1])
    // Show exit label if trade labels enabled
    if showTradeLabels
        was_long = is_long[1]
        exit_pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
        exit_pnl_pct = strategy.closedtrades.profit_percent(strategy.closedtrades - 1)
        exit_r = initial_sl_dist[1] > 0 ? exit_pnl / (strategy.position_avg_price[1] * initial_sl_dist[1] / 100) : 0.0

        exit_label = exit_pnl >= 0 ? "✅ EXIT\n" : "❌ SL HIT\n"
        exit_label := exit_label + (exit_pnl >= 0 ? "+" : "") + str.tostring(exit_pnl_pct, "#.#") + "% (" + (exit_r >= 0 ? "+" : "") + str.tostring(exit_r, "#.#") + "R)"

        label.new(bar_index, was_long ? (high + atrValue) : (low - atrValue), exit_label,
             style=was_long ? label.style_label_down : label.style_label_up,
             color=exit_pnl >= 0 ? color.new(colBull, 10) : color.new(colBear, 10),
             textcolor=color.white, size=size.normal, yloc=yloc.price)

    entry_price := na
    avg_entry := na
    stop_loss := na
    partial_tp1_price := na
    partial_tp2_price := na
    partial_tp3_price := na
    partial_tp4_price := na
    liq_price := na
    initial_sl_dist := na
    dca_count := 0
    base_qty := 0.0
    total_qty := 0.0
    is_long := false
    is_short := false
    partial1_taken := false
    partial2_taken := false
    partial3_taken := false
    partial4_taken := false
    breakeven_moved := false
    trail_activated := false
    trail_high := na
    trail_low := na
    tp1_trailing := false
    tp2_trailing := false
    tp3_trailing := false
    tp4_trailing := false
    tp1_trail_high := na
    tp2_trail_high := na
    tp3_trail_high := na
    tp4_trail_high := na
    tp1_trail_low := na
    tp2_trail_low := na
    tp3_trail_low := na
    tp4_trail_low := na
    tp_update_counter := 0
    bars_since_partial2 := 0
    bars_since_last_dca := 999
    bars_since_all_dcas_complete := 0
    all_dcas_completed := false

// ══════════════════════════════════════════════════════════════════════════════
// 🔄 DCA HELPERS
// ══════════════════════════════════════════════════════════════════════════════

calc_dca_qty(base, dca_num) =>
    base * math.pow(dca_size_mult, dca_num - 1)

// 🎯 GUNBOT DCA METHOD CHECK
check_dca_method(avg_price, is_long_pos) =>
    result = false

    if dca_method == "HIGHBB"
        // HIGHBB: Köp när upper BB (för long) eller lower BB (för short) korsar under/över avg_entry
        if is_long_pos
            // Long: Köp när upper BB korsar UNDER sista avg_entry (priset har fallit)
            result := bb_upper < avg_price
        else
            // Short: Sälj när lower BB korsar ÖVER sista avg_entry (priset har stigit)
            result := bb_lower > avg_price

    else if dca_method == "RSI"
        // RSI: Köp inom RSI-range
        if is_long_pos
            // Long: RSI under low threshold (översålt)
            result := rsi <= rsi_dca_low
        else
            // Short: RSI över high threshold (överköpt)
            result := rsi >= rsi_dca_high

    else  // Percentage mode
        // Percentage: Köp vid fixed % drop (redan hanterat av buydown)
        result := true

    result

get_bot_code(action) =>
    action + "_" + exchange_name + "_" + pair_name + "_" + strategy_name_bot + "_" + bot_id

// ══════════════════════════════════════════════════════════════════════════════
// 📋 JSON GENERATOR FUNCTIONS FOR WUNDERTRADING
// ══════════════════════════════════════════════════════════════════════════════

// Build entry JSON with TP levels and SL (WunderTrading format)
build_entry_json(is_long_entry, qty, sl_price, tp1_price, tp2_price, tp3_price, tp4_price) =>
    code = get_bot_code(is_long_entry ? "ENTER-LONG" : "ENTER-SHORT")

    // Start building JSON
    json = '{"code":"' + code + '",'
    json := json + '"orderType":"market",'
    json := json + '"amountPerTrade":' + str.tostring(qty, '#.########') + ','
    json := json + '"amountPerTradeType":"contracts",'
    json := json + '"leverage":' + str.tostring(leverage, '#.#') + ','

    // Build takeProfits array - NOTE: portfolio must be in DECIMAL form (25% = 0.25)
    json := json + '"takeProfits":['

    tp_count = 0

    if partial1_enabled and not na(tp1_price)
        if tp_count > 0
            json := json + ','
        // Convert percentage to decimal: 25% -> 0.25
        portfolio_decimal = partial1_pct / 100
        json := json + '{"price":' + str.tostring(tp1_price, '#.########') + ',"portfolio":' + str.tostring(portfolio_decimal, '#.##') + '}'
        tp_count := tp_count + 1

    if partial2_enabled and not na(tp2_price)
        if tp_count > 0
            json := json + ','
        portfolio_decimal = partial2_pct / 100
        json := json + '{"price":' + str.tostring(tp2_price, '#.########') + ',"portfolio":' + str.tostring(portfolio_decimal, '#.##') + '}'
        tp_count := tp_count + 1

    if partial3_enabled and not na(tp3_price)
        if tp_count > 0
            json := json + ','
        portfolio_decimal = partial3_pct / 100
        json := json + '{"price":' + str.tostring(tp3_price, '#.########') + ',"portfolio":' + str.tostring(portfolio_decimal, '#.##') + '}'
        tp_count := tp_count + 1

    if partial4_enabled and not na(tp4_price)
        if tp_count > 0
            json := json + ','
        portfolio_decimal = partial4_pct / 100
        json := json + '{"price":' + str.tostring(tp4_price, '#.########') + ',"portfolio":' + str.tostring(portfolio_decimal, '#.##') + '}'
        tp_count := tp_count + 1

    json := json + '],'

    // Add stopLoss - WunderTrading format (no "type" field)
    json := json + '"stopLoss":{"price":' + str.tostring(sl_price, '#.########') + '},'

    // Add additional parameters
    json := json + '"reduceOnly":true,'
    json := json + '"placeConditionalOrdersOnExchange":false'

    json := json + '}'
    json

// Build exit JSON for partial TP or full close (WunderTrading format)
build_exit_json(is_long_pos, qty) =>
    code = get_bot_code(is_long_pos ? "EXIT-LONG" : "EXIT-SHORT")

    json = '{"code":"' + code + '",'
    json := json + '"amountPerTrade":' + str.tostring(qty, '#.########') + ','
    json := json + '"amountPerTradeType":"contracts",'
    json := json + '"reduceOnly":true,'
    json := json + '"placeConditionalOrdersOnExchange":false'
    json := json + '}'
    json

// Build DCA entry JSON (WunderTrading format - no TP/SL since position already exists)
build_dca_json(is_long_pos, qty) =>
    code = get_bot_code(is_long_pos ? "ENTER-LONG" : "ENTER-SHORT")

    json = '{"code":"' + code + '",'
    json := json + '"orderType":"market",'
    json := json + '"amountPerTrade":' + str.tostring(qty, '#.########') + ','
    json := json + '"amountPerTradeType":"contracts",'
    json := json + '"reduceOnly":false,'
    json := json + '"placeConditionalOrdersOnExchange":false'
    json := json + '}'
    json

// ══════════════════════════════════════════════════════════════════════════════
// 🚀 ENTRIES
// ══════════════════════════════════════════════════════════════════════════════

// LONG ENTRY
if longCond and not in_position
    // DCA-aware SL calculation: ensure SL is beyond furthest DCA level
    furthest_dca_dist = atrValue * dynamicDCAMult * dca_max_entries
    min_sl_dist = furthest_dca_dist + (atrValue * 0.5)
    actual_sl_dist = use_dca and dca_max_entries > 1 ? math.max(atrValue * dynamicSLMult, min_sl_dist) : atrValue * dynamicSLMult
    raw_sl = close - actual_sl_dist

    safe_sl = calc_safe_sl(close, raw_sl, true)
    sl_dist = close - safe_sl
    liq = calc_liq_price(close, true)
    sl_to_liq_pct = (safe_sl - liq) / close * 100

    if sl_to_liq_pct >= min_liq_distance
        entry_price := close
        avg_entry := close
        stop_loss := safe_sl

        // Sätt partial TP prices baserat på dynamiska R-multiplar
        partial_tp1_price := partial1_enabled ? close + (sl_dist * dynamicPartial1_R) : na
        partial_tp2_price := partial2_enabled ? close + (sl_dist * dynamicPartial2_R) : na
        partial_tp3_price := partial3_enabled ? close + (sl_dist * dynamicPartial3_R) : na
        partial_tp4_price := partial4_enabled ? close + (sl_dist * dynamicPartial4_R) : na

        liq_price := liq
        initial_sl_dist := sl_dist
        dca_count := 0  // Börja på 0 så första DCA blir DCA #1
        is_long := true
        is_short := false
        partial1_taken := false
        partial2_taken := false
        partial3_taken := false
        partial4_taken := false
        breakeven_moved := false
        trail_activated := false
        trail_high := high
        trail_low := low

        // Dynamic position sizing
        qty_pct = use_dynamic_sizing ? math.min(position_pct, 100 / (sl_dist / close * 100)) : position_pct
        entry_qty = strategy.equity * qty_pct / 100 / close

        base_qty := entry_qty
        total_qty := entry_qty

        // Build entry JSON with all TP levels and SL
        entry_json = build_entry_json(true, entry_qty, safe_sl, partial_tp1_price, partial_tp2_price, partial_tp3_price, partial_tp4_price)
        strategy.entry("Long", strategy.long, qty=entry_qty, comment=entry_json)

        // Send alert with JSON for webhook
        alert(entry_json, alert.freq_once_per_bar_close)

        if showTradeLabels
            first_tp = partial1_enabled ? partial_tp1_price : na
            rr = not na(first_tp) ? (first_tp - close) / sl_dist : 0
            label.new(bar_index, low - atrValue * 2, "🟢 LONG\n💰 " + str.tostring(close, format.mintick) + "\n🛑 SL: " + str.tostring(safe_sl, format.mintick) + (not na(first_tp) ? "\n📊 TP1: " + str.tostring(first_tp, format.mintick) : "") + (rr > 0 ? "\n📊 R:R " + str.tostring(rr, "#.#") : ""),
                 style=label.style_label_up, color=color.new(colBull, 10), textcolor=color.white, size=size.normal, yloc=yloc.price)

// SHORT ENTRY
if shortCond and not in_position
    // DCA-aware SL calculation: ensure SL is beyond furthest DCA level
    furthest_dca_dist = atrValue * dynamicDCAMult * dca_max_entries
    min_sl_dist = furthest_dca_dist + (atrValue * 0.5)
    actual_sl_dist = use_dca and dca_max_entries > 1 ? math.max(atrValue * dynamicSLMult, min_sl_dist) : atrValue * dynamicSLMult
    raw_sl = close + actual_sl_dist

    safe_sl = calc_safe_sl(close, raw_sl, false)
    sl_dist = safe_sl - close
    liq = calc_liq_price(close, false)
    sl_to_liq_pct = (liq - safe_sl) / close * 100

    if sl_to_liq_pct >= min_liq_distance
        entry_price := close
        avg_entry := close
        stop_loss := safe_sl

        // Sätt partial TP prices baserat på dynamiska R-multiplar
        partial_tp1_price := partial1_enabled ? close - (sl_dist * dynamicPartial1_R) : na
        partial_tp2_price := partial2_enabled ? close - (sl_dist * dynamicPartial2_R) : na
        partial_tp3_price := partial3_enabled ? close - (sl_dist * dynamicPartial3_R) : na
        partial_tp4_price := partial4_enabled ? close - (sl_dist * dynamicPartial4_R) : na

        liq_price := liq
        initial_sl_dist := sl_dist
        dca_count := 0  // Börja på 0 så första DCA blir DCA #1
        is_long := false
        is_short := true
        partial1_taken := false
        partial2_taken := false
        partial3_taken := false
        partial4_taken := false
        breakeven_moved := false
        trail_activated := false
        trail_high := high
        trail_low := low

        qty_pct = use_dynamic_sizing ? math.min(position_pct, 100 / (sl_dist / close * 100)) : position_pct
        entry_qty = strategy.equity * qty_pct / 100 / close

        base_qty := entry_qty
        total_qty := entry_qty

        // Build entry JSON with all TP levels and SL
        entry_json = build_entry_json(false, entry_qty, safe_sl, partial_tp1_price, partial_tp2_price, partial_tp3_price, partial_tp4_price)
        strategy.entry("Short", strategy.short, qty=entry_qty, comment=entry_json)

        // Send alert with JSON for webhook
        alert(entry_json, alert.freq_once_per_bar_close)

        if showTradeLabels
            first_tp = partial1_enabled ? partial_tp1_price : na
            rr = not na(first_tp) ? (close - first_tp) / sl_dist : 0
            label.new(bar_index, high + atrValue * 2, "🔴 SHORT\n💰 " + str.tostring(close, format.mintick) + "\n🛑 SL: " + str.tostring(safe_sl, format.mintick) + (not na(first_tp) ? "\n📊 TP1: " + str.tostring(first_tp, format.mintick) : "") + (rr > 0 ? "\n📊 R:R " + str.tostring(rr, "#.#") : ""),
                 style=label.style_label_down, color=color.new(colBear, 10), textcolor=color.white, size=size.normal, yloc=yloc.price)

// ══════════════════════════════════════════════════════════════════════════════
// 🔄 DCA (FÖRBÄTTRAD)
// ══════════════════════════════════════════════════════════════════════════════

if use_dca and in_position and dca_count < dca_max_entries
    // Räkna upp bars since last DCA
    bars_since_last_dca += 1

    // 🎯 GUNBOT BUYDOWN: Minimum % price drop från avg_entry
    price_drop_pct = is_long ? (avg_entry - close) / avg_entry * 100 : (close - avg_entry) / avg_entry * 100
    buydown_ok = price_drop_pct >= du_buydown

    // 🎯 GUNBOT DCA METHOD: HIGHBB, RSI, eller Percentage
    dca_method_ok = check_dca_method(avg_entry, is_long)

    // Kontrollera att trenden håller i sig
    trend_ok = not require_trend_for_dca or (is_long and bullTrend) or (is_short and bearTrend)

    // ⏰ DCA COOLDOWN: Minimum bars sedan sista DCA
    cooldown_ok = bars_since_last_dca >= dca_cooldown_bars

    if buydown_ok and dca_method_ok and trend_ok and cooldown_ok
        dca_qty = calc_dca_qty(base_qty, dca_count + 1)
        current_value = avg_entry * total_qty
        new_value = close * dca_qty
        new_total = total_qty + dca_qty
        new_avg = (current_value + new_value) / new_total

        if is_long
            raw_sl = new_avg - (atrValue * dynamicSLMult)
            new_sl = calc_safe_sl(new_avg, raw_sl, true)
            new_liq = calc_liq_price(new_avg, true)

            if (new_sl - new_liq) / new_avg * 100 >= min_liq_distance
                avg_entry := new_avg
                stop_loss := new_sl
                liq_price := new_liq

                // Uppdatera partial TP prices från nya avg_entry (dynamiska R-multiplar)
                new_sl_dist = new_avg - new_sl
                partial_tp1_price := partial1_enabled ? new_avg + (new_sl_dist * dynamicPartial1_R) : na
                partial_tp2_price := partial2_enabled ? new_avg + (new_sl_dist * dynamicPartial2_R) : na
                partial_tp3_price := partial3_enabled ? new_avg + (new_sl_dist * dynamicPartial3_R) : na
                partial_tp4_price := partial4_enabled ? new_avg + (new_sl_dist * dynamicPartial4_R) : na

                total_qty := new_total
                dca_count += 1
                bars_since_last_dca := 0  // Reset cooldown

                // Build DCA entry JSON
                dca_json = build_dca_json(true, dca_qty)
                strategy.entry("Long", strategy.long, qty=dca_qty, comment=dca_json)

                // Send alert with JSON for webhook
                alert(dca_json, alert.freq_once_per_bar_close)

                if showTradeLabels
                    label.new(bar_index, low - atrValue * 1.5, "🔄 DCA#" + str.tostring(dca_count) + "\n📊 Avg: " + str.tostring(new_avg, format.mintick),
                         style=label.style_label_up, color=color.new(colDCA, 10), textcolor=color.white, size=size.normal, yloc=yloc.price)

        else if is_short
            raw_sl = new_avg + (atrValue * dynamicSLMult)
            new_sl = calc_safe_sl(new_avg, raw_sl, false)
            new_liq = calc_liq_price(new_avg, false)

            if (new_liq - new_sl) / new_avg * 100 >= min_liq_distance
                avg_entry := new_avg
                stop_loss := new_sl
                liq_price := new_liq

                // Uppdatera partial TP prices från nya avg_entry (dynamiska R-multiplar)
                new_sl_dist = new_sl - new_avg
                partial_tp1_price := partial1_enabled ? new_avg - (new_sl_dist * dynamicPartial1_R) : na
                partial_tp2_price := partial2_enabled ? new_avg - (new_sl_dist * dynamicPartial2_R) : na
                partial_tp3_price := partial3_enabled ? new_avg - (new_sl_dist * dynamicPartial3_R) : na
                partial_tp4_price := partial4_enabled ? new_avg - (new_sl_dist * dynamicPartial4_R) : na

                total_qty := new_total
                dca_count += 1
                bars_since_last_dca := 0  // Reset cooldown

                // Build DCA entry JSON
                dca_json = build_dca_json(false, dca_qty)
                strategy.entry("Short", strategy.short, qty=dca_qty, comment=dca_json)

                // Send alert with JSON for webhook
                alert(dca_json, alert.freq_once_per_bar_close)

                if showTradeLabels
                    label.new(bar_index, high + atrValue * 1.5, "🔄 DCA#" + str.tostring(dca_count) + "\n📊 Avg: " + str.tostring(new_avg, format.mintick),
                         style=label.style_label_down, color=color.new(colDCA, 10), textcolor=color.white, size=size.normal, yloc=yloc.price)

// ══════════════════════════════════════════════════════════════════════════════
// 📊 DYNAMISK TP UPPDATERING & TRAILING
// ══════════════════════════════════════════════════════════════════════════════

if in_position and not na(avg_entry) and not na(initial_sl_dist)
    // Räkna upp counter
    tp_update_counter += 1

    // ⏰ Checka om alla DCAs är klara och räkna bars
    if use_dca and dca_count >= dca_max_entries
        if not all_dcas_completed
            all_dcas_completed := true
            bars_since_all_dcas_complete := 0
        else
            bars_since_all_dcas_complete += 1
    else if not use_dca
        // Ingen DCA används - räkna bars från entry
        bars_since_all_dcas_complete += 1

    // 📊 DYNAMISK TP UPPDATERING - Baserat på löpande ATR
    if useDynamicPartialTP and tp_update_counter % tp_atr_adjustment_freq == 0
        // Beräkna nya TP-nivåer baserat på AKTUELL ATR (inte initial)
        current_sl_dist = atrValue * dynamicSLMult

        if partial1_enabled and not partial1_taken
            if is_long
                partial_tp1_price := avg_entry + (current_sl_dist * dynamicPartial1_R)
            else
                partial_tp1_price := avg_entry - (current_sl_dist * dynamicPartial1_R)

        if partial2_enabled and not partial2_taken
            if is_long
                partial_tp2_price := avg_entry + (current_sl_dist * dynamicPartial2_R)
            else
                partial_tp2_price := avg_entry - (current_sl_dist * dynamicPartial2_R)

        if partial3_enabled and not partial3_taken
            if is_long
                partial_tp3_price := avg_entry + (current_sl_dist * dynamicPartial3_R)
            else
                partial_tp3_price := avg_entry - (current_sl_dist * dynamicPartial3_R)

        if partial4_enabled and not partial4_taken
            if is_long
                partial_tp4_price := avg_entry + (current_sl_dist * dynamicPartial4_R)
            else
                partial_tp4_price := avg_entry - (current_sl_dist * dynamicPartial4_R)

    // ⏰ TP TIME DECAY - Dra ner TP3/TP4 närmare med tiden
    if use_tp_time_decay and partial2_taken
        // Räkna bars since TP2 taken
        bars_since_partial2 += 1

        if bars_since_partial2 >= tp_decay_start_bars
            // Beräkna decay multiplier baserat på tiden
            bars_over_start = bars_since_partial2 - tp_decay_start_bars
            decay_periods = math.floor(bars_over_start / 10)  // Decay per 10 bars
            total_decay_pct = decay_periods * tp_decay_rate

            // Applicera decay på TP3
            if partial3_enabled and not partial3_taken and not na(partial_tp3_price)
                dist_to_tp3 = is_long ? partial_tp3_price - avg_entry : avg_entry - partial_tp3_price
                decayed_dist = dist_to_tp3 * (1 - total_decay_pct / 100)
                if is_long
                    partial_tp3_price := avg_entry + decayed_dist
                else
                    partial_tp3_price := avg_entry - decayed_dist

            // Applicera decay på TP4
            if partial4_enabled and not partial4_taken and not na(partial_tp4_price)
                dist_to_tp4 = is_long ? partial_tp4_price - avg_entry : avg_entry - partial_tp4_price
                decayed_dist = dist_to_tp4 * (1 - total_decay_pct / 100)
                if is_long
                    partial_tp4_price := avg_entry + decayed_dist
                else
                    partial_tp4_price := avg_entry - decayed_dist

    // 🎯 TP TRAILING - Trail TP när priset närmar sig
    if use_tp_trailing
        // TP1 Trailing
        if partial1_enabled and not partial1_taken and not na(partial_tp1_price)
            dist_to_tp1 = is_long ? partial_tp1_price - avg_entry : avg_entry - partial_tp1_price
            progress_to_tp1 = is_long ? (high - avg_entry) / dist_to_tp1 * 100 : (avg_entry - low) / dist_to_tp1 * 100

            if progress_to_tp1 >= tp_trail_activation_pct
                if not tp1_trailing
                    tp1_trailing := true
                    tp1_trail_high := is_long ? high : na
                    tp1_trail_low := is_short ? low : na

                if tp1_trailing
                    if is_long
                        tp1_trail_high := math.max(tp1_trail_high, high)
                        new_tp1 = tp1_trail_high * (1 - tp_trail_offset_pct / 100)
                        if new_tp1 > partial_tp1_price
                            partial_tp1_price := new_tp1
                    else
                        tp1_trail_low := math.min(tp1_trail_low, low)
                        new_tp1 = tp1_trail_low * (1 + tp_trail_offset_pct / 100)
                        if new_tp1 < partial_tp1_price
                            partial_tp1_price := new_tp1

        // TP2 Trailing
        if partial2_enabled and not partial2_taken and not na(partial_tp2_price)
            dist_to_tp2 = is_long ? partial_tp2_price - avg_entry : avg_entry - partial_tp2_price
            progress_to_tp2 = is_long ? (high - avg_entry) / dist_to_tp2 * 100 : (avg_entry - low) / dist_to_tp2 * 100

            if progress_to_tp2 >= tp_trail_activation_pct
                if not tp2_trailing
                    tp2_trailing := true
                    tp2_trail_high := is_long ? high : na
                    tp2_trail_low := is_short ? low : na

                if tp2_trailing
                    if is_long
                        tp2_trail_high := math.max(tp2_trail_high, high)
                        new_tp2 = tp2_trail_high * (1 - tp_trail_offset_pct / 100)
                        if new_tp2 > partial_tp2_price
                            partial_tp2_price := new_tp2
                    else
                        tp2_trail_low := math.min(tp2_trail_low, low)
                        new_tp2 = tp2_trail_low * (1 + tp_trail_offset_pct / 100)
                        if new_tp2 < partial_tp2_price
                            partial_tp2_price := new_tp2

        // TP3 Trailing
        if partial3_enabled and not partial3_taken and not na(partial_tp3_price)
            dist_to_tp3 = is_long ? partial_tp3_price - avg_entry : avg_entry - partial_tp3_price
            progress_to_tp3 = is_long ? (high - avg_entry) / dist_to_tp3 * 100 : (avg_entry - low) / dist_to_tp3 * 100

            if progress_to_tp3 >= tp_trail_activation_pct
                if not tp3_trailing
                    tp3_trailing := true
                    tp3_trail_high := is_long ? high : na
                    tp3_trail_low := is_short ? low : na

                if tp3_trailing
                    if is_long
                        tp3_trail_high := math.max(tp3_trail_high, high)
                        new_tp3 = tp3_trail_high * (1 - tp_trail_offset_pct / 100)
                        if new_tp3 > partial_tp3_price
                            partial_tp3_price := new_tp3
                    else
                        tp3_trail_low := math.min(tp3_trail_low, low)
                        new_tp3 = tp3_trail_low * (1 + tp_trail_offset_pct / 100)
                        if new_tp3 < partial_tp3_price
                            partial_tp3_price := new_tp3

        // TP4 Trailing
        if partial4_enabled and not partial4_taken and not na(partial_tp4_price)
            dist_to_tp4 = is_long ? partial_tp4_price - avg_entry : avg_entry - partial_tp4_price
            progress_to_tp4 = is_long ? (high - avg_entry) / dist_to_tp4 * 100 : (avg_entry - low) / dist_to_tp4 * 100

            if progress_to_tp4 >= tp_trail_activation_pct
                if not tp4_trailing
                    tp4_trailing := true
                    tp4_trail_high := is_long ? high : na
                    tp4_trail_low := is_short ? low : na

                if tp4_trailing
                    if is_long
                        tp4_trail_high := math.max(tp4_trail_high, high)
                        new_tp4 = tp4_trail_high * (1 - tp_trail_offset_pct / 100)
                        if new_tp4 > partial_tp4_price
                            partial_tp4_price := new_tp4
                    else
                        tp4_trail_low := math.min(tp4_trail_low, low)
                        new_tp4 = tp4_trail_low * (1 + tp_trail_offset_pct / 100)
                        if new_tp4 < partial_tp4_price
                            partial_tp4_price := new_tp4

// ══════════════════════════════════════════════════════════════════════════════
// 🚨 NÖDBROMS
// ══════════════════════════════════════════════════════════════════════════════

if in_position and not na(liq_price)
    // Använd sparad liq_price istället för att beräkna om
    dist_to_liq = is_long ? (close - liq_price) / close * 100 : (liq_price - close) / close * 100

    if dist_to_liq < min_liq_distance
        // Build exit JSON for emergency close
        exit_json = build_exit_json(is_long, math.abs(strategy.position_size))
        strategy.close_all(comment=exit_json)

        // Send alert with JSON for webhook
        alert(exit_json, alert.freq_once_per_bar_close)
        exit_alert_sent_this_bar := true

        if showTradeLabels
            label.new(bar_index, is_long ? (low - atrValue * 2.5) : (high + atrValue * 2.5), "⚠️ NÖDSTOPP!\n🚨 För nära likvidation\n📉 " + str.tostring(dist_to_liq, "#.#") + "% till liq",
                 style=is_long ? label.style_label_up : label.style_label_down, color=colLiq, textcolor=color.white, size=size.large, yloc=yloc.price)

// ══════════════════════════════════════════════════════════════════════════════
// 💰 MULTI-LEVEL PARTIAL TAKE PROFIT
// ══════════════════════════════════════════════════════════════════════════════

// Partial TP Level 1
if usePartialTP and partial1_enabled and in_position and not partial1_taken and not na(partial_tp1_price)
    partial1_hit = (is_long and high >= partial_tp1_price) or (is_short and low <= partial_tp1_price)

    if partial1_hit
        // Använd total_qty (ursprunglig + DCAs) istället för strategy.position_size (kvarvarande)
        partial_qty = total_qty * (partial1_pct / 100)

        // Build exit JSON for partial TP
        exit_json = build_exit_json(is_long, math.abs(partial_qty))

        if is_long
            strategy.close("Long", qty=math.abs(partial_qty), comment=exit_json)
        else
            strategy.close("Short", qty=math.abs(partial_qty), comment=exit_json)

        exit_alert_sent_this_bar := true

        partial1_taken := true

        if showTradeLabels
            profit_pct = is_long ? (partial_tp1_price - strategy.position_avg_price) / strategy.position_avg_price * 100 : (strategy.position_avg_price - partial_tp1_price) / strategy.position_avg_price * 100
            label.new(bar_index, is_long ? (high + atrValue * 1.5) : (low - atrValue * 1.5), "💰 TP1\n✅ " + str.tostring(partial1_pct, "#") + "% @ +" + str.tostring(profit_pct, "#.#") + "%",
                 style=is_long ? label.style_label_down : label.style_label_up, color=color.new(colPartial, 10), textcolor=color.white, size=size.normal, yloc=yloc.price)

// Partial TP Level 2
if usePartialTP and partial2_enabled and in_position and not partial2_taken and not na(partial_tp2_price)
    partial2_hit = (is_long and high >= partial_tp2_price) or (is_short and low <= partial_tp2_price)

    if partial2_hit
        // Använd total_qty (ursprunglig + DCAs) istället för strategy.position_size (kvarvarande)
        partial_qty = total_qty * (partial2_pct / 100)

        // Build exit JSON for partial TP
        exit_json = build_exit_json(is_long, math.abs(partial_qty))

        if is_long
            strategy.close("Long", qty=math.abs(partial_qty), comment=exit_json)
        else
            strategy.close("Short", qty=math.abs(partial_qty), comment=exit_json)

        exit_alert_sent_this_bar := true

        partial2_taken := true

        if showTradeLabels
            profit_pct = is_long ? (partial_tp2_price - strategy.position_avg_price) / strategy.position_avg_price * 100 : (strategy.position_avg_price - partial_tp2_price) / strategy.position_avg_price * 100
            label.new(bar_index, is_long ? (high + atrValue * 1.5) : (low - atrValue * 1.5), "💰 TP2\n✅ " + str.tostring(partial2_pct, "#") + "% @ +" + str.tostring(profit_pct, "#.#") + "%",
                 style=is_long ? label.style_label_down : label.style_label_up, color=color.new(colPartial, 10), textcolor=color.white, size=size.normal, yloc=yloc.price)

// Partial TP Level 3
if usePartialTP and partial3_enabled and in_position and not partial3_taken and not na(partial_tp3_price)
    partial3_hit = (is_long and high >= partial_tp3_price) or (is_short and low <= partial_tp3_price)

    if partial3_hit
        // Använd total_qty (ursprunglig + DCAs) istället för strategy.position_size (kvarvarande)
        partial_qty = total_qty * (partial3_pct / 100)

        // Build exit JSON for partial TP
        exit_json = build_exit_json(is_long, math.abs(partial_qty))

        if is_long
            strategy.close("Long", qty=math.abs(partial_qty), comment=exit_json)
        else
            strategy.close("Short", qty=math.abs(partial_qty), comment=exit_json)

        exit_alert_sent_this_bar := true

        partial3_taken := true

        if showTradeLabels
            profit_pct = is_long ? (partial_tp3_price - strategy.position_avg_price) / strategy.position_avg_price * 100 : (strategy.position_avg_price - partial_tp3_price) / strategy.position_avg_price * 100
            label.new(bar_index, is_long ? (high + atrValue * 1.5) : (low - atrValue * 1.5), "💰 TP3\n✅ " + str.tostring(partial3_pct, "#") + "% @ +" + str.tostring(profit_pct, "#.#") + "%",
                 style=is_long ? label.style_label_down : label.style_label_up, color=color.new(colPartial, 10), textcolor=color.white, size=size.normal, yloc=yloc.price)

// Partial TP Level 4
if usePartialTP and partial4_enabled and in_position and not partial4_taken and not na(partial_tp4_price)
    partial4_hit = (is_long and high >= partial_tp4_price) or (is_short and low <= partial_tp4_price)

    if partial4_hit
        // Använd total_qty (ursprunglig + DCAs) istället för strategy.position_size (kvarvarande)
        partial_qty = total_qty * (partial4_pct / 100)

        // Build exit JSON for partial TP
        exit_json = build_exit_json(is_long, math.abs(partial_qty))

        if is_long
            strategy.close("Long", qty=math.abs(partial_qty), comment=exit_json)
        else
            strategy.close("Short", qty=math.abs(partial_qty), comment=exit_json)

        exit_alert_sent_this_bar := true

        partial4_taken := true

        if showTradeLabels
            profit_pct = is_long ? (partial_tp4_price - strategy.position_avg_price) / strategy.position_avg_price * 100 : (strategy.position_avg_price - partial_tp4_price) / strategy.position_avg_price * 100
            label.new(bar_index, is_long ? (high + atrValue * 1.5) : (low - atrValue * 1.5), "💰 TP4\n✅ " + str.tostring(partial4_pct, "#") + "% @ +" + str.tostring(profit_pct, "#.#") + "%",
                 style=is_long ? label.style_label_down : label.style_label_up, color=color.new(colPartial, 10), textcolor=color.white, size=size.normal, yloc=yloc.price)

// ══════════════════════════════════════════════════════════════════════════════
// 🎯 RISK MANAGEMENT (BREAKEVEN & TRAILING)
// ══════════════════════════════════════════════════════════════════════════════

if in_position and not na(avg_entry) and not na(initial_sl_dist)

    // Track high/low
    if is_long
        trail_high := na(trail_high) ? high : math.max(trail_high, high)
    else
        trail_low := na(trail_low) ? low : math.min(trail_low, low)

    // Current profit in R
    current_r = is_long ? (high - avg_entry) / initial_sl_dist : (avg_entry - low) / initial_sl_dist

    // Breakeven move
    if useBreakeven and not breakeven_moved and current_r >= breakevenTrigger
        if is_long and stop_loss < avg_entry
            stop_loss := avg_entry + (atrValue * 0.1)  // Lite över breakeven
            breakeven_moved := true
            if showTradeLabels
                label.new(bar_index, low - atrValue, "⚖️ Breakeven\n🔒 SL flyttad", style=label.style_label_up, color=color.new(color.blue, 20), textcolor=color.white, size=size.normal, yloc=yloc.price)

        else if is_short and stop_loss > avg_entry
            stop_loss := avg_entry - (atrValue * 0.1)
            breakeven_moved := true
            if showTradeLabels
                label.new(bar_index, high + atrValue, "⚖️ Breakeven\n🔒 SL flyttad", style=label.style_label_down, color=color.new(color.blue, 20), textcolor=color.white, size=size.normal, yloc=yloc.price)

    // Trailing Stop Activation
    if useTrailingStop and current_r >= trailActivation
        if not trail_activated
            trail_activated := true
            if showTradeLabels
                label.new(bar_index, is_long ? (low - atrValue) : (high + atrValue), "🔥 Trailing Aktiverad",
                     style=is_long ? label.style_label_up : label.style_label_down,
                     color=color.new(color.orange, 20), textcolor=color.white, size=size.tiny, yloc=yloc.price)

        // Update trailing stop
        if is_long
            new_trail_sl = trail_high - (atrValue * trailOffset)
            if new_trail_sl > stop_loss
                stop_loss := new_trail_sl
        else
            new_trail_sl = trail_low + (atrValue * trailOffset)
            if new_trail_sl < stop_loss
                stop_loss := new_trail_sl

// ══════════════════════════════════════════════════════════════════════════════
// 🎯 EXITS
// ══════════════════════════════════════════════════════════════════════════════

// Check if SL cooldown has passed after all DCAs complete
sl_cooldown_passed = bars_since_all_dcas_complete >= sl_cooldown_after_dca
sl_active = in_position and (not use_dca or (dca_count >= dca_max_entries and sl_cooldown_passed))

if in_position and not na(stop_loss)
    // Build exit JSON for SL
    exit_json = build_exit_json(is_long, math.abs(strategy.position_size))

    if is_long
        if sl_active
            // SL active after cooldown period following all DCAs
            strategy.exit("Exit Long", "Long", stop=stop_loss, comment_loss=exit_json)
        // DCAs still pending or cooldown not passed - no SL, only partial TPs

    if is_short
        if sl_active
            // SL active after cooldown period following all DCAs
            strategy.exit("Exit Short", "Short", stop=stop_loss, comment_loss=exit_json)
        // DCAs still pending or cooldown not passed - no SL, only partial TPs

// Alerts now handled via strategy.order.comment in TradingView alert settings

// ══════════════════════════════════════════════════════════════════════════════
// 🎨 VISUALS
// ══════════════════════════════════════════════════════════════════════════════

// EMAs
pFast = plot(showEMAs ? emaFast : na, "Fast EMA", colFastEMA, 2)
pSlow = plot(showEMAs ? emaSlow : na, "Slow EMA", colSlowEMA, 2)
pTrend = plot(showEMAs ? emaTrend : na, "Trend EMA", colTrendEMA, 3)

// EMA Fill
fill(pFast, pSlow, emaFast > emaSlow ? color.new(colBull, 90) : color.new(colBear, 90))

// SL Line - VISA alltid när in position (men bara aktiv efter cooldown)
plot(showSLTP and in_position ? stop_loss : na, "🛑 Stop Loss", colSL, 1, plot.style_linebr)

// UNIT COST LINE - visar EXAKT inköpspris (från TradingView)
plot(in_position ? strategy.position_avg_price : na, "🏷️ Unit Cost (Avg Entry)", colUnitCost, 1, plot.style_linebr)

// Multi-Level Partial TP Lines
plot(showPartialTP and in_position and partial1_enabled and not partial1_taken ? partial_tp1_price : na, "📊 Partial TP1", colPartial, 1, plot.style_linebr)
plot(showPartialTP and in_position and partial2_enabled and not partial2_taken ? partial_tp2_price : na, "📊 Partial TP2", colPartial, 1, plot.style_linebr)
plot(showPartialTP and in_position and partial3_enabled and not partial3_taken ? partial_tp3_price : na, "📊 Partial TP3", colPartial, 1, plot.style_linebr)
plot(showPartialTP and in_position and partial4_enabled and not partial4_taken ? partial_tp4_price : na, "📊 Partial TP4", colPartial, 1, plot.style_linebr)

plot(showLiqLine and in_position ? liq_price : na, "⚠️ Liquidation", colLiq, 1, plot.style_linebr)

// Breakeven Line
plot(showBreakeven and in_position and breakeven_moved ? avg_entry : na, "⚖️ Breakeven", colBreakeven, 1, plot.style_linebr)

// DCA level (visar buydown-nivå)
dca_buydown_level = showDCALevels and use_dca and in_position and dca_count < dca_max_entries ?
     (is_long ? avg_entry - avg_entry * (du_buydown / 100) : avg_entry + avg_entry * (du_buydown / 100)) : na
plot(dca_buydown_level, "🔄 DCA Buydown Level", colDCA, 1, plot.style_linebr)

// 📊 BOLLINGER BANDS (för HIGHBB DCA)
pBBUpper = plot(showBollingerBands ? bb_upper : na, "📊 BB Upper", colBBUpper, 1)
pBBBasis = plot(showBollingerBands ? bb_basis : na, "📊 BB Basis", colBBBasis, 1, plot.style_line)
pBBLower = plot(showBollingerBands ? bb_lower : na, "📊 BB Lower", colBBLower, 1)
fill(pBBUpper, pBBLower, color.new(colBBUpper, 95), title="BB Fill")

// ══════════════════════════════════════════════════════════════════════════════
// 📊 STATS
// ══════════════════════════════════════════════════════════════════════════════

totalTrades = strategy.closedtrades
winRate = totalTrades > 0 ? strategy.wintrades / totalTrades * 100 : 0.0
profitFactor = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0.0
avgWin = strategy.wintrades > 0 ? strategy.grossprofit / strategy.wintrades : 0.0
avgLoss = strategy.losstrades > 0 ? math.abs(strategy.grossloss / strategy.losstrades) : 0.0
avgRR = avgLoss > 0 ? avgWin / avgLoss : 0.0

currentPnL = in_position and not na(avg_entry) ? (is_long ? (close - avg_entry) / avg_entry * 100 * leverage : (avg_entry - close) / avg_entry * 100 * leverage) : 0.0
distToLiq = in_position and not na(liq_price) ? (is_long ? (close - liq_price) / close * 100 : (liq_price - close) / close * 100) : 0.0
currentR = in_position and not na(avg_entry) and not na(initial_sl_dist) ? (is_long ? (close - avg_entry) / initial_sl_dist : (avg_entry - close) / initial_sl_dist) : 0.0

// ══════════════════════════════════════════════════════════════════════════════
// 📋 INFO PANEL (FÖRBÄTTRAD)
// ══════════════════════════════════════════════════════════════════════════════

if showInfoPanel
    var table panel = table.new(position.top_right, 2, 25, bgcolor=color.new(#000000, 90), border_width=1, border_color=color.new(#2962FF, 70))

    // Prepare compact data
    posTxt = is_long ? "🟢 LONG" : is_short ? "🔴 SHORT" : "⚪ FLAT"
    posCol = is_long ? colBull : is_short ? colBear : color.gray

    // P&L + R combined
    pnlR = in_position ? (currentPnL >= 0 ? "+" : "") + str.tostring(currentPnL, "#.#") + "% (" + (currentR >= 0 ? "+" : "") + str.tostring(currentR, "#.#") + "R)" : "—"
    pnlCol = currentPnL >= 0 ? colBull : colBear

    // Entry + count
    entryTxt = in_position ? str.tostring(strategy.position_avg_price, format.mintick) + " ×" + str.tostring(dca_count + 1) : "—"

    // SL compact
    slTxt = "—"
    if in_position and use_dca and dca_count < dca_max_entries
        slTxt := "⏸️ DCA"
    else if in_position and not sl_active
        slTxt := "⏳" + str.tostring(sl_cooldown_after_dca - bars_since_all_dcas_complete) + "b"
    else if in_position
        slTxt := str.tostring(stop_loss, format.mintick)
        if breakeven_moved
            slTxt := slTxt + "🔒"

    // TP status
    tp_taken_count = (partial1_taken ? 1 : 0) + (partial2_taken ? 1 : 0) + (partial3_taken ? 1 : 0) + (partial4_taken ? 1 : 0)
    tpTxt = usePartialTP ? str.tostring(tp_taken_count) + "/" + str.tostring(numPartialLevels) : "OFF"

    // DCA status
    dca_done = use_dca and in_position ? math.max(0, dca_count - 1) : 0
    dcaTxt = use_dca ? str.tostring(dca_done) + "/" + str.tostring(dca_max_entries) : "OFF"

    // Trend
    trendTxt = bullTrend ? "🟢 BULL" : bearTrend ? "🔴 BEAR" : "🟡 NEUT"
    trendCol = bullTrend ? colBull : bearTrend ? colBear : color.yellow

    // ADX status
    adxStatus = adxValue >= adxStrong ? "💪" : adxValue >= adxThreshold ? "✓" : "⚠️"
    adxCol = adxValue >= adxStrong ? colBull : adxValue >= adxThreshold ? color.yellow : colBear

    // MACD compact
    macdTxt = (macdLine > signalLine ? "🟢" : "🔴") + (macdHistGrowing ? "⬆" : "⬇")

    // Volume status
    volStatus = volRatio >= volThreshold ? "🔥" : volRatio >= 1.0 ? "📊" : "🧊"
    volCol = volRatio >= volThreshold ? colBull : volRatio >= 1.0 ? color.yellow : color.gray

    // Stats colors
    wrCol = winRate >= 50 ? colBull : winRate >= 40 ? color.yellow : colBear
    pfCol = profitFactor >= 2.0 ? colBull : profitFactor >= 1.5 ? color.yellow : colBear
    rrCol = avgRR >= 2.0 ? colBull : avgRR >= 1.5 ? color.yellow : colBear
    netCol = strategy.netprofit >= 0 ? colBull : colBear

    row = 0

    // Header
    table.cell(panel, 0, row, "⚡ HYPE", text_color=color.white, text_size=size.normal, bgcolor=color.new(#2962FF, 60))
    table.cell(panel, 1, row, posTxt, text_color=posCol, text_size=size.normal, bgcolor=color.new(#2962FF, 60))
    row += 1

    // P&L + R
    table.cell(panel, 0, row, "💰 P&L", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, pnlR, text_color=in_position ? pnlCol : color.gray, text_size=size.small)
    row += 1

    // Entry + count
    table.cell(panel, 0, row, "🏷️ Entry", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, entryTxt, text_color=color.yellow, text_size=size.small)
    row += 1

    // SL
    table.cell(panel, 0, row, "🛑 SL", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, slTxt, text_color=colSL, text_size=size.small)
    row += 1

    // Liq
    table.cell(panel, 0, row, "⚠️ Liq", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, in_position ? str.tostring(liq_price, format.mintick) : "—", text_color=colLiq, text_size=size.small)
    row += 1

    // TP
    table.cell(panel, 0, row, "🎯 TP", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, tpTxt, text_color=colPartial, text_size=size.small)
    row += 1

    // Trail
    if useTrailingStop and in_position
        trailTxt = trail_activated ? "🔥 ON" : "OFF"
        table.cell(panel, 0, row, "📐 Trail", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, row, trailTxt, text_color=trail_activated ? color.orange : color.gray, text_size=size.small)
        row += 1

    // DCA
    table.cell(panel, 0, row, "🔄 DCA", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, dcaTxt, text_color=colDCA, text_size=size.small)
    row += 1

    // Trend
    table.cell(panel, 0, row, "📈 Trend", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, trendTxt, text_color=trendCol, text_size=size.small)
    row += 1

    // ADX
    table.cell(panel, 0, row, "⚡ ADX", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, str.tostring(adxValue, "#.#") + " " + adxStatus, text_color=adxCol, text_size=size.small)
    row += 1

    // MACD
    table.cell(panel, 0, row, "📊 MACD", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, macdTxt, text_color=color.white, text_size=size.small)
    row += 1

    // Volume
    table.cell(panel, 0, row, "🌊 Vol", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, volStatus + " " + str.tostring(volRatio, "#.#"), text_color=volCol, text_size=size.small)
    row += 1

    // Dynamic multipliers (if active)
    if useDynamicSL or useDynamicDCA
        dynTxt = ""
        if useDynamicSL
            dynTxt := "SL:" + str.tostring(dynamicSLMult, "#.#")
        if useDynamicDCA
            dynTxt := dynTxt + (dynTxt != "" ? " " : "") + "DCA:" + str.tostring(dynamicDCAMult, "#.#")
        table.cell(panel, 0, row, "🔧 ATR×", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, row, dynTxt, text_color=color.aqua, text_size=size.small)
        row += 1

    // R values (if dynamic TP active)
    if useDynamicPartialTP
        r_values = str.tostring(dynamicPartial1_R, "#.#")
        if numPartialLevels >= 2
            r_values += "," + str.tostring(dynamicPartial2_R, "#.#")
        if numPartialLevels >= 3
            r_values += "," + str.tostring(dynamicPartial3_R, "#.#")
        if numPartialLevels >= 4
            r_values += "," + str.tostring(dynamicPartial4_R, "#.#")
        table.cell(panel, 0, row, "🎯 R's", text_color=color.gray, text_size=size.small)
        table.cell(panel, 1, row, r_values, text_color=colPartial, text_size=size.small)
        row += 1

    // Stats: Trades + Win Rate combined
    table.cell(panel, 0, row, "📈 Stats", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, str.tostring(totalTrades) + "T " + str.tostring(winRate, "#") + "%", text_color=wrCol, text_size=size.small)
    row += 1

    // PF / RR combined
    table.cell(panel, 0, row, "💎 PF/RR", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, str.tostring(profitFactor, "#.#") + " / " + str.tostring(avgRR, "#.#"), text_color=pfCol, text_size=size.small)
    row += 1

    // Net P&L
    table.cell(panel, 0, row, "💵 Net", text_color=color.gray, text_size=size.small)
    table.cell(panel, 1, row, "$" + str.tostring(strategy.netprofit, "#"), text_color=netCol, text_size=size.small)
    row += 1

// ══════════════════════════════════════════════════════════════════════════════
//
// Detta script är nu kompatibelt med WunderTrading via strategy.order.comment
//
// SETUP I TRADINGVIEW:
// 1. Klicka på "Alert" knappen (klockan) i TradingView
// 2. Condition: Välj din strategy name
// 3. Webhook URL: https://wtalerts.com/bot/trading_view
// 4. Alert message:
//    {
//        "code": "{{strategy.order.comment}}",
//        "amountPerTrade": "{{strategy.order.contracts}}",
//        "amountPerTradeType": "quote"
//    }
// 5. Notifications: Webhook URL (check)
// 6. Alert name: WunderTrading (eller vad du vill)
//
// Bot-koden (ENTER-LONG, EXIT-SHORT, etc.) sätts automatiskt i strategy.order.comment
// och WunderTrading läser den från {{strategy.order.comment}} placeholder
