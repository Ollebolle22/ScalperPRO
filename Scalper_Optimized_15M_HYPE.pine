// 🎯 GUNBOT DCA METHOD
dca_method = input.string("HIGHBB", "🎯 DCA Method",
     options=["HIGHBB", "RSI", "Percentage"],
     group=grpDCA,
     tooltip="HIGHBB = köp när upper BB korsar under sista köppris | RSI = köp inom RSI-range | Percentage = fast % drop")

du_buydown = input.float(2.0, "📉 Buydown %", step=0.5, group=grpDCA, tooltip="Minimum % price drop från sista avg_entry för DCA")

// 🔄 DYNAMISK DCA SPACING (Volatilitetsbaserad)
useDynamicDCA = input.bool(true, "✓ Dynamisk DCA Spacing", group=grpDCA, tooltip="DCA-avstånd anpassas efter volatilitet")
