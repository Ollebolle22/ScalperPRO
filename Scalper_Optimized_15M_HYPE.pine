dca_fixed_pct = input.float(4.0, "Fixed % avstånd (Percentage mode)", step=0.5, group=grpDCA, tooltip="Används endast om DCA Method = Percentage")
dca_size_mult = input.float(1.5, "📊 Ratio (DOUBLE_UP_CAP)", step=0.1, group=grpDCA, tooltip="Gunbot ratio - mängd quote currency för varje DCA relativt till holdings")
require_trend_for_dca = input.bool(true, "✓ Kräv fortsatt trend för DCA", group=grpDCA, tooltip="Tillåt bara DCA om trenden håller i sig")

// 📊 BOLLINGER BANDS (för HIGHBB DCA)
bb_length = input.int(20, "BB Length", minval=1, group=grpDCA, tooltip="Bollinger Bands period för HIGHBB metod")
bb_mult = input.float(2.0, "BB Multiplier", step=0.1, group=grpDCA, tooltip="Bollinger Bands standard deviation multiplier")

// 📉 RSI DCA SETTINGS
rsi_length = input.int(14, "RSI Length", minval=1, group=grpDCA, tooltip="RSI period för RSI DCA metod")
rsi_dca_low = input.int(30, "RSI DCA Low", minval=0, maxval=100, group=grpDCA, tooltip="Lägsta RSI-värde för DCA (long)")
rsi_dca_high = input.int(70, "RSI DCA High", minval=0, maxval=100, group=grpDCA, tooltip="Högsta RSI-värde för DCA (short)")

// 🎯 DCA TRAILING
use_dca_trailing = input.bool(false, "✓ DCA Trailing", group=grpDCA, tooltip="Vänta på lägsta pris innan DCA triggas")
dca_trail_pct = input.float(0.5, "DCA Trail %", step=0.1, group=grpDCA, tooltip="Trail DCA trigger med denna %")

// ⏰ DCA COOLDOWN
dca_cooldown_bars = input.int(10, "⏰ DCA Cooldown (bars)", minval=1, group=grpDCA, tooltip="Minimum bars mellan DCA entries - förhindrar för täta DCAs")

// ══════════════════════════════════════════════════════════════════════════════
// 📈 TREND SETTINGS (OPTIMERADE FÖR 15MIN)
// ══════════════════════════════════════════════════════════════════════════════

grpTrend = "📈 Trend Settings [15M Optimized]"
emaFastLen = input.int(21, "Fast EMA Length", group=grpTrend, tooltip="Ökat från 12 till 21 för 15min - minskar whipsaws")
emaSlowLen = input.int(50, "Slow EMA Length", group=grpTrend, tooltip="Ökat från 26 till 50 för tydligare crossovers")
emaTrendLen = input.int(100, "Trend EMA Length", group=grpTrend, tooltip="Ökat från 50 till 100 för stark trend filter")
emaSource = input.source(close, "EMA Source", group=grpTrend)
requireTrendAlignment = input.bool(true, "✓ Kräv trend-alignment", group=grpTrend, tooltip="STARKT REKOMMENDERAT - filtrera mot trenden")
emaSpacing = input.float(0.15, "Min EMA-spacing %", step=0.05, group=grpTrend, tooltip="Kräv att EMAs är separerade - 0.15% = mildare, 0.3% = striktare")

// ══════════════════════════════════════════════════════════════════════════════
// 💪 ADX TREND STRENGTH (NYTT!)
// ══════════════════════════════════════════════════════════════════════════════

grpADX = "💪 ADX Trend Strength [NYT!]"
useADX = input.bool(true, "✓ Använd ADX Filter", group=grpADX, tooltip="KRITISKT - filtrera svaga trender")
adxLen = input.int(14, "ADX Length", group=grpADX)
