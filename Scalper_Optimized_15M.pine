//@version=6
strategy("⚡ Momentum Scalper PRO v9.3 [15M Optimized]",
     overlay=true,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_bars_back=500)

// ══════════════════════════════════════════════════════════════════════════════
// ⚙️ STRATEGY PROPERTIES (flyttat från hardcoded settings)
// ══════════════════════════════════════════════════════════════════════════════

grpStrategy = "⚙️ Strategy Properties"
initial_capital = input.float(10000, "💵 Initial Capital", step=100, group=grpStrategy, tooltip="Startkapital för backtest")
commission_pct = input.float(0.06, "💸 Commission %", step=0.01, group=grpStrategy, tooltip="Provision per trade (0.06 = 0.06%)")
slippage_ticks = input.int(2, "📉 Slippage (ticks)", step=1, group=grpStrategy, tooltip="Slippage i ticks")
max_pyramiding = input.int(3, "📊 Max Pyramiding", step=1, group=grpStrategy, tooltip="Max antal samtidiga entries (DCA räknas hit)")

// ══════════════════════════════════════════════════════════════════════════════
// 💰 KAPITAL & LEVERAGE
// ══════════════════════════════════════════════════════════════════════════════

grpCapital = "💰 Kapital & Leverage"
leverage = input.float(5.0, "📊 Leverage", step=0.5, group=grpCapital, tooltip="Hävstång på börsen")
liq_buffer_pct = input.float(30.0, "🛡️ Likvidations-buffer %", step=5.0, group=grpCapital, tooltip="Säkerhetsmarginal till likvidationspris - ÖKA för säkerhet")
position_pct = input.float(95.0, "📍 Position Size %", step=5.0, group=grpCapital, tooltip="Andel av equity per trade")
min_liq_distance = input.float(8.0, "🚨 Min avstånd till liq %", step=1.0, group=grpCapital, tooltip="Minsta tillåtna avstånd till likvidation")
use_dynamic_sizing = input.bool(true, "✓ Dynamic Position Sizing", group=grpCapital, tooltip="Justera position size baserat på ATR/volatilitet")

// ══════════════════════════════════════════════════════════════════════════════
// 🔄 DCA SETTINGS (FÖRBÄTTRAD)
// ══════════════════════════════════════════════════════════════════════════════

grpDCA = "🔄 DCA (Dollar Cost Average)"
use_dca = input.bool(true, "✓ Aktivera DCA", group=grpDCA, tooltip="Lägg till position vid drawdown - NU MED BÄTTRE KONTROLL")
dca_max_entries = input.int(2, "Max DCA entries", group=grpDCA, tooltip="Reducerat från 5 till 2 för bättre risk management")
dca_mode = input.string("ATR Smart", "DCA Trigger-läge", options=["ATR Smart", "Fixed %"], group=grpDCA, tooltip="ATR Smart rekommenderas för 15min")
dca_atr_mult = input.float(2.5, "ATR Multiplikator", step=0.25, group=grpDCA, tooltip="Ökat från 2.0 till 2.5 för 15min")
dca_fixed_pct = input.float(4.0, "Fixed % avstånd", step=0.5, group=grpDCA, tooltip="Ökat från 3% till 4% för 15min volatilitet")
dca_size_mult = input.float(1.3, "Storlek multiplikator", step=0.1, group=grpDCA, tooltip="Reducerat från 1.5 för säkrare DCA")
require_trend_for_dca = input.bool(true, "✓ Kräv fortsatt trend för DCA", group=grpDCA, tooltip="NYT: Tillåt bara DCA om trenden håller i sig")

// ══════════════════════════════════════════════════════════════════════════════
// 📈 TREND SETTINGS (OPTIMERADE FÖR 15MIN)
// ══════════════════════════════════════════════════════════════════════════════

grpTrend = "📈 Trend Settings [15M Optimized]"
emaFastLen = input.int(21, "Fast EMA Length", group=grpTrend, tooltip="Ökat från 12 till 21 för 15min - minskar whipsaws")
emaSlowLen = input.int(50, "Slow EMA Length", group=grpTrend, tooltip="Ökat från 26 till 50 för tydligare crossovers")
emaTrendLen = input.int(100, "Trend EMA Length", group=grpTrend, tooltip="Ökat från 50 till 100 för stark trend filter")
emaSource = input.source(close, "EMA Source", group=grpTrend)
requireTrendAlignment = input.bool(true, "✓ Kräv trend-alignment", group=grpTrend, tooltip="STARKT REKOMMENDERAT - filtrera mot trenden")
emaSpacing = input.float(0.15, "Min EMA-spacing %", step=0.05, group=grpTrend, tooltip="Kräv att EMAs är separerade - 0.15% = mildare, 0.3% = striktare")

// ══════════════════════════════════════════════════════════════════════════════
// 💪 ADX TREND STRENGTH (NYTT!)
// ══════════════════════════════════════════════════════════════════════════════

grpADX = "💪 ADX Trend Strength [NYT!]"
useADX = input.bool(true, "✓ Använd ADX Filter", group=grpADX, tooltip="KRITISKT - filtrera svaga trender")
adxLen = input.int(14, "ADX Length", group=grpADX)
adxThreshold = input.int(22, "ADX Minimum", group=grpADX, tooltip="22+ = måttlig trend, 25+ = stark trend")
